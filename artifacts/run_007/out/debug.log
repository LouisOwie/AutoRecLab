it.algorithms import als, basic\\n\\nnp.random.seed(42)\\n\\nexperiment_data = {\\n    \'MovieLens100K\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\\n    \'AmazonVideoGames\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\\n    \'LastFM\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\\n}\\n\\nDATASETS = {\\n    \'MovieLens100K\': {\'path\': os.path.join(os.getcwd(), \'u.data\'), \'sep\': \'\\\\t\', \'columns\': [\'user\', \'item\', \'rating\', \'timestamp\'], \'kind\': \'movielens\'},\\n    \'AmazonVideoGames\': {\'path\': os.path.join(os.getcwd(), \'VideoGames.csv\'), \'sep\': \',\', \'columns\': None, \'kind\': \'amazon\'},\\n    \'LastFM\': {\'path\': os.path.join(os.getcwd(), \'user_taggedartists-timestamps.dat\'), \'sep\': \'\\\\t\', \'columns\': None, \'kind\': \'lastfm\'},\\n}\\nSEEDS = [11, 22, 33, 44, 55]\\nKS = [1, 5, 10]\\nALGO_NAMES = [\'ALS\', \'ItemKNN\', \'Pop\']\\n\\ndef _standardize_cols(df):\\n    cols = {c.lower(): c for c in df.columns}\\n    return cols\\n\\ndef load_dataset(name, meta):\\n    p = meta[\'path\']\\n    if name == \'MovieLens100K\':\\n        df = pd.read_csv(p, sep=\'\\\\t\', header=None, names=[\'user\', \'item\', \'rating\', \'timestamp\'])\\n        df = df[df[\'rating\'] > 3].copy()\\n    elif name == \'AmazonVideoGames\':\\n        df = pd.read_csv(p)\\n        cols = _standardize_cols(df)\\n        user_col = cols.get(\'reviewerid\') or cols.get(\'user_id\') or cols.get(\'reviewer_id\') or list(df.columns)[0]\\n        item_col = cols.get(\'asin\') or cols.get(\'item_id\') or list(df.columns)[1]\\n        rating_col = cols.get(\'overall\') or cols.get(\'rating\') or list(df.columns)[2]\\n        df = df[[user_col, item_col, rating_col]].copy()\\n        df.columns = [\'user\', \'item\', \'rating\']\\n        df = df[df[\'rating\'] > 3].copy()\\n    elif name == \'LastFM\':\\n        df = pd.read_csv(p, sep=\'\\\\t\')\\n        cols = _standardize_cols(df)\\n        user_col = cols.get(\'userID\'.lower()) or cols.get(\'user\') or list(df.columns)[0]\\n        item_col = cols.get(\'artistid\'.lower()) or cols.get(\'artist_id\') or cols.get(\'artist\') or list(df.columns)[1]\\n        df = df[[user_col, item_col]].copy()\\n        df.columns = [\'user\', \'item\']\\n        df[\'rating\'] = 1.0\\n    else:\\n        raise ValueError(name)\\n    df = df[[\'user\', \'item\', \'rating\']].copy()\\n    df[\'user\'] = df[\'user\'].astype(str)\\n    df[\'item\'] = df[\'item\'].astype(str)\\n    if \'rating\' not in df:\\n        df[\'rating\'] = 1.0\\n    df = df.groupby([\'user\', \'item\'], as_index=False)[\'rating\'].max()\\n    return df\\n\\ndef core_filter(df, min_uc=5, min_ic=5):\\n    changed = True\\n    while changed:\\n        changed = False\\n        ucounts = df.groupby(\'user\').size()\\n        keep_u = ucounts[ucounts >= min_uc].index\\n        df2 = df[df[\'user\'].isin(keep_u)]\\n        icounts = df2.groupby(\'item\').size()\\n        keep_i = icounts[icounts >= min_ic].index\\n        df3 = df2[df2[\'item\'].isin(keep_i)]\\n        if len(df3) != len(df):\\n            changed = True\\n        df = df3\\n    return df.reset_index(drop=True)\\n\\ndef user_holdout_split(df, seed, frac=0.2):\\n    rng = np.random.default_rng(seed)\\n    train_parts = []\\n    test_parts = []\\n    for u, g in df.groupby(\'user\'):\\n        idx = g.index.to_numpy()\\n        n_test = max(1, int(round(len(idx) * frac)))\\n        test_idx = rng.choice(idx, size=n_test, replace=False)\\n        train_idx = np.setdiff1d(idx, test_idx)\\n        if len(train_idx) == 0:\\n            train_idx, test_idx = idx[:1], idx[1:]\\n        train_parts.append(df.loc[train_idx])\\n        test_parts.append(df.loc[test_idx])\\n    train = pd.concat(train_parts, ignore_index=True)\\n    test = pd.concat(test_parts, ignore_index=True)\\n    return train, test\\n\\ndef make_topn_lists(train, test, algo, kmax=10):\\n    train_ui = train[[\'user\', \'item\']].copy()\\n    test_ui = test[[\'user\', \'item\']].copy()\\n    reco = topn.recommend(algo, train_ui, users=test_ui[\'user\'].unique(), k=kmax, exclude_known=True)\\n    return reco, test_ui\\n\\ndef eval_metrics(reco, test, ks=(1, 5, 10)):\\n    gt = test.groupby(\'user\')[\'item\'].apply(list).to_dict()\\n    reco = reco.copy()\\n    reco[\'rank\'] = reco.groupby(\'user\').cumcount() + 1\\n    out = {}\\n    for k in ks:\\n        precs, ndcgs = [], []\\n        for u, true_items in gt.items():\\n            user_rec = reco[(reco[\'user\'] == u) & (reco[\'rank\'] <= k)][\'item\'].tolist()\\n            hits = [1 if i in true_items else 0 for i in user_rec]\\n            precs.append(sum(hits) / k)\\n            dcg = sum(h / math.log2(r + 2) for r, h in enumerate(hits))\\n            ideal = min(len(true_items), k)\\n            idcg = sum(1.0 / math.log2(r + 2) for r in range(ideal)) if ideal > 0 else 1.0\\n            ndcgs.append(dcg / idcg if idcg > 0 else 0.0)\\n        out[f\'precision@{k}\'] = float(np.mean(precs))\\n        out[f\'ndcg@{k}\'] = float(np.mean(ndcgs))\\n    return out\\n\\ndef build_algorithms(train):\\n    items = train[\'item\'].unique()\\n    item_pop = basic.PopularityRecommender()\\n    item_knn = basic.ItemItem(20)\\n    als_model = als.BiasedMF(features=20, iterations=15, reg=0.1)\\n    return {\'Pop\': item_pop, \'ItemKNN\': item_knn, \'ALS\': als_model}\\n\\ndef fit_predict(algo, train, test_users):\\n    algo.fit(train[[\'user\', \'item\']])\\n    recs = topn.recommend(algo, train[[\'user\', \'item\']], users=test_users, k=10, exclude_known=True)\\n    return recs\\n\\nall_results = []\\nfor ds_name, meta in DATASETS.items():\\n    print(f\'Loading {ds_name}...\')\\n    df = load_dataset(ds_name, meta)\\n    df = core_filter(df, 5, 5