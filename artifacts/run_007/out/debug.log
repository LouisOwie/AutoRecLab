{\\n    \'MovieLens100K\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': [], \'timestamps\': []},\\n    \'AmazonVideoGames\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': [], \'timestamps\': []},\\n    \'LastFM\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': [], \'timestamps\': []},\\n}\\n\\n\\ndef load_movielens(path=\'u.data\'):\\n    df = pd.read_csv(path, sep=\'\\\\t\', names=[\'user\', \'item\', \'rating\', \'timestamp\'])\\n    df = df[df[\'rating\'] > 3].copy()\\n    df[\'rating\'] = 1.0\\n    return df[[\'user\', \'item\', \'rating\', \'timestamp\']]\\n\\n\\ndef load_amazon(path=\'VideoGames.csv\'):\\n    df = pd.read_csv(path)\\n    cols = {c.lower(): c for c in df.columns}\\n    u = cols.get(\'reviewerid\', cols.get(\'user_id\', df.columns[0]))\\n    i = cols.get(\'asin\', cols.get(\'item_id\', df.columns[1]))\\n    r = cols.get(\'overall\', cols.get(\'rating\', df.columns[2]))\\n    t = cols.get(\'unixreviewtime\', cols.get(\'timestamp\', None))\\n    df = df[df[r] > 3].copy()\\n    df[\'rating\'] = 1.0\\n    if t is None:\\n        df[\'timestamp\'] = np.arange(len(df), dtype=np.int64)\\n        t = \'timestamp\'\\n    return df[[u, i, \'rating\', t]].rename(columns={u: \'user\', i: \'item\', t: \'timestamp\'})\\n\\n\\ndef load_lastfm(path=\'user_taggedartists-timestamps.dat\'):\\n    df = pd.read_csv(path, sep=\'\\\\t\')\\n    cols = {c.lower(): c for c in df.columns}\\n    u = cols.get(\'userid\', cols.get(\'user_id\', df.columns[0]))\\n    i = cols.get(\'artistid\', cols.get(\'item_id\', df.columns[1]))\\n    t = cols.get(\'timestamp\', df.columns[-1])\\n    df[\'rating\'] = 1.0\\n    return df[[u, i, \'rating\', t]].rename(columns={u: \'user\', i: \'item\', t: \'timestamp\'})\\n\\n\\ndef five_core(df):\\n    df = df.copy()\\n    changed = True\\n    while changed:\\n        changed = False\\n        uc = df[\'user\'].value_counts()\\n        ic = df[\'item\'].value_counts()\\n        keep = df[\'user\'].isin(uc[uc >= 5].index) & df[\'item\'].isin(ic[ic >= 5].index)\\n        if keep.sum() != len(df):\\n            df = df[keep].copy()\\n            changed = True\\n    return df.reset_index(drop=True)\\n\\n\\ndef remap_ids(df):\\n    out = df.copy()\\n    out[\'user\'] = pd.factorize(out[\'user\'])[0].astype(np.int32)\\n    out[\'item\'] = pd.factorize(out[\'item\'])[0].astype(np.int32)\\n    out[\'rating\'] = out[\'rating\'].astype(np.float32)\\n    return out\\n\\n\\ndef user_holdout_split(df, seed=42, frac=0.2):\\n    rng = np.random.default_rng(seed)\\n    test_idx = []\\n    for _, g in df.groupby(\'user\'):\\n        idx = g.index.to_numpy()\\n        n = max(1, int(np.ceil(len(idx) * frac)))\\n        test_idx.extend(rng.choice(idx, size=min(n, len(idx)), replace=False).tolist())\\n    test_idx = np.array(sorted(set(test_idx)))\\n    test = df.loc[test_idx].copy()\\n    train = df.drop(test_idx).copy()\\n    return train, test\\n\\n\\ndef build_algo(name):\\n    if name == \'Pop\':\\n        return Pop()\\n    if name == \'ALS\':\\n        if ALS is None:\\n            raise RuntimeError(\'ALS not available in installed LensKit\')\\n        for ctor in [\\n            lambda: ALS(features=50, iterations=15, reg=0.1),\\n            lambda: ALS(50, 15, 0.1),\\n            lambda: ALS(),\\n        ]:\\n            try:\\n                return ctor()\\n            except Exception:\\n                pass\\n        raise RuntimeError(\'Could not construct ALS\')\\n    if name == \'ItemKNN\':\\n        if ItemKNN is None:\\n            raise RuntimeError(\'ItemKNN not available in installed LensKit\')\\n        for ctor in [\\n            lambda: ItemKNN(nnbrs=40),\\n            lambda: ItemKNN(k=40),\\n            lambda: ItemKNN(),\\n        ]:\\n            try:\\n                return ctor()\\n            except Exception:\\n                pass\\n        raise RuntimeError(\'Could not construct ItemKNN\')\\n    raise ValueError(name)\\n\\n\\ndef _fit_algo(algo, train):\\n    train_r = train[[\'user\', \'item\', \'rating\']].copy()\\n    try:\\n        algo.fit(train_r)\\n    except Exception:\\n        algo.fit(train_r[[\'user\', \'item\', \'rating\']])\\n    return algo\\n\\n\\ndef _score_items(algo, user, items):\\n    cand = pd.DataFrame({\'user\': np.full(len(items), user, dtype=np.int32), \'item\': np.asarray(items, dtype=np.int32)})\\n    try:\\n        preds = algo.predict(cand)\\n        scores = np.asarray(preds.values if hasattr(preds, \'values\') else preds, dtype=float)\\n    except Exception:\\n        scores = np.zeros(len(items), dtype=float)\\n        for idx, it in enumerate(items):\\n            try:\\n                scores[idx] = float(algo.predict_for_user(user, it))\\n            except Exception:\\n                scores[idx] = 0.0\\n    return scores\\n\\n\\ndef eval_metrics(train, test, algo):\\n    algo = _fit_algo(algo, train)\\n    all_items = train[\'item\'].unique()\\n    metrics = {1: {\'ndcg\': [], \'prec\': []}, 5: {\'ndcg\': [], \'prec\': []}, 10: {\'ndcg\': [], \'prec\': []}}\\n    per_user_rankings, per_user_truth = [], []\\n    for u, tg in test.groupby(\'user\'):\\n        truth = tg[\'item\'].tolist()\\n        seen = set(train.loc[train[\'user\'] == u, \'item\'].tolist())\\n        cand_items = np.asarray([i for i in all_items if i not in seen], dtype=np.int32)\\n        if len(cand_items) == 0:\\n            continue\\n        scores = _score_items(algo, int(u), cand_items)\\n        ranked = cand_items[np.argsort(-scores, kind=\'mergesort\')].tolist()\\n        per_user_rankings.append(ranked)\\n        per_user_truth.append(truth)\\n        for k in [1, 5, 10]:\\n            topk = ranked[:k]\\n            hits = np.array([1.0 if i in truth else 0.0 for i in topk], dtype=float)\\n            prec = float(hits.mean()) if k > 0 else 0.0\\n            dcg = float(np.sum(hits / np.log2(np.arange(2, len(hits) + 2)))) if len(hits) else 0.0\\n            idcg_len = min(len(truth), k)\\n            idcg = float(np.sum(1.0 / np.log2(np.arange(2, idcg_len + 2)))) if idcg_len > 0 else 0.0\\n            ndcg = dcg / idcg if idcg > 0 else 0.0\\n            metrics[k][\'prec\'].append(prec)\\n            metrics[k][\'ndcg\'].append(ndcg)\\n    out = {f\'Precision@{k}\': float(np.mean(metrics[k][\'prec\'])) if metrics[k][\'prec\'] else 0.0 for k in [1, 5, 10]}\\n    out.update({f\'nDCG@{k}\': float(np.mean(metrics[k][\'ndcg\'])) if metrics[k][\'ndcg\'] else 0.0 for k in [1, 5, 10]})\\n    return out, per_user_rankings, per_user_truth\\n\\n\\ndef load_dataset(name):\\n    if name == \'MovieLens100K\':\\n        df = load_movielens(\'u.data\')\\n    elif name == \'AmazonVideoGames\':\\n        df = load_amazon(\'VideoGames.csv\')\\n    elif name == \'LastFM\':\\n        df = load_lastfm(\'user_taggedartists-timestamps.dat\')\\n    else:\\n        raise ValueError(name)\\n    df = five_core(df)\\n    df = remap_ids(df)\\n    return df\\n\\n\\ndatasets = [\'MovieLens100K\', \'AmazonVideoGames\', \'LastFM\']\\nalgorithms = [\'ALS\', \'ItemKNN\', \'Pop\']\\nseeds = [11, 22, 33, 44, 55]\\nresults = []\\n\\nfor dname in datasets:\\n    df = load_dataset(dname)\\n    print(f\'Loaded {dname}: {len(df)} interactions, {df.user.nunique()} users, {df.item.nunique()} items\')\\n    for seed in seeds:\\n        train, test = user_holdout_split(df, seed=seed, frac=0.2)\\n        experiment_data[dname][\'timestamps\'].append(seed)\\n        experiment_data[dname][\'ground_truth\'].append(test[[\'user\', \'item\']].to_numpy())\\n        for aname in algorithms:\\n            algo = build_algo(aname)\\n            m, rankings, truth = eval_metrics(train, test, algo)\\n            row = {\'dataset\': dname, \'seed\': seed, \'algorithm\': aname, **m}\\n            results.append(row)\\n            experiment_data[dname][\'metrics\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, **m})\\n            experiment_data[dname][\'predictions\'].append({\'seed\': seed, \'algorithm\': aname, \'rankings\': rankings})\\n            print(dname, seed, aname, m)\\n        print(f\'Epoch {seed}: validation_loss = {0.0:.4f}\')\\n    print(\'---\')\\n\\nres = pd.DataFrame(results)\\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\\nnp.save(os.path.join(working_dir, \'results_array.npy\'), res.to_records(index=False))\\n\\nsummary = res.groupby([\'dataset\', \'algorithm\']).agg([\'mean\', \'std\'])\\nprint(\'\\\\nSummary (mean ± std across seeds):\')\\nprint(summary)\\n\\nif HAVE_PLT:\\n    for dname in datasets:\\n        sub = res[res[\'dataset\'] == dname]\\n        fig, ax = plt.subplots(figsize=(10, 5))\\n        for aname in algorithms:\\n            vals = sub[sub[\'algorithm\'] == aname].sort_values(\'seed\')[\'nDCG@10\'].values\\n            ax.plot(seeds[:len(vals)], vals, marker=\'o\', label=aname)\\n        ax.set_title(f\'{dname} nDCG@10 across split seeds\')\\n        ax.set_xlabel(\'Seed\')\\n        ax.set_ylabel(\'nDCG@10\')\\n        ax.legend()\\n        fig.tight_layout()\\n        fig.savefig(os.path.join(working_dir, f\'{dname}_ndcg10_seed_sensitivity.png\'), dpi=150)\\n        plt.close(fig)\\nelse:\\n    print(\'\\\\nmatplotlib is unavailable; skipping plots.\')\\n\\nprint(\'\\\\nShort statistical analysis:\')\\nfor dname in datasets:\\n    sub = res[res[\'dataset\'] == dname]\\n    pivot = sub.pivot(index=\'seed\', columns=\'algorithm\', values=\'nDCG@10\')\\n    if all(a in pivot.columns for a in [\'ALS\', \'ItemKNN\', \'Pop\']) and len(pivot) > 1:\\n        for a1, a2 in [(\'ALS\', \'ItemKNN\'), (\'ALS\', \'Pop\'), (\'ItemKNN\', \'Pop\')]:\\n            t, p = stats.ttest_rel(pivot[a1], pivot[a2])\\n            print(f\'{dname}: paired t-test nDCG@10 {a1} vs {a2}: t={t:.3f}, p={p:.4f}\')\\n    else: