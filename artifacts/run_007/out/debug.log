iasedMF\nfrom lenskit.algorithms.basic import Popular\nfrom lenskit.algorithms.item_knn import ItemItem\n\nseeds = [11, 22, 33, 44, 55]\nks = [1, 5, 10]\ndatasets = {\n    'MovieLens100K': {'path': 'u.data', 'sep': '\\t'},\n    'AmazonVideoGames': {'path': 'VideoGames.csv', 'sep': ','},\n    'LastFM': {'path': 'user_taggedartists-timestamps.dat', 'sep': '\\t'},\n}\nalg_names = ['ALS', 'ItemKNN', 'Pop']\n\nexperiment_data = {d: {'metrics': {'train': [], 'val': []}, 'losses': {'train': [], 'val': []}, 'predictions': [], 'ground_truth': [], 'per_seed': []} for d in datasets}\n\n\ndef _detect_cols(df, candidates):\n    cols = {c.lower().strip(): c for c in df.columns}\n    for cand_list in candidates:\n        for c in cand_list:\n            if c in cols:\n                return cols[c]\n    return None\n\n\ndef load_dataset(name, cfg):\n    p = cfg['path']\n    if not os.path.exists(p):\n        raise FileNotFoundError(f'Missing {p}')\n\n    if name == 'MovieLens100K':\n        df = pd.read_csv(p, sep='\\t', names=['user', 'item', 'rating', 'timestamp'], engine='python')\n        df = df[df['rating'] > 3].copy()\n    elif name == 'AmazonVideoGames':\n        try:\n            df = pd.read_csv(p, sep=cfg['sep'])\n        except Exception:\n            df = pd.read_csv(p)\n        ucol = _detect_cols(df, [['user_id', 'reviewerid', 'reviewer_id', 'user'],])\n        icol = _detect_cols(df, [['item_id', 'asin', 'item'],])\n        rcol = _detect_cols(df, [['rating', 'overall'],])\n        if ucol is None or icol is None:\n            raise ValueError('Could not identify user/item columns in Amazon data')\n        if rcol is not None:\n            df = df[df[rcol] > 3].copy()\n        df = df.rename(columns={ucol: 'user', icol: 'item'})\n        df['timestamp'] = np.arange(len(df))\n    elif name == 'LastFM':\n        df = pd.read_csv(p, sep='\\t')\n        ucol = _detect_cols(df, [['user_id', 'user'],])\n        icol = _detect_cols(df, [['artist_id', 'item_id', 'artist'],])\n        wcol = _detect_cols(df, [['weight'],])\n        if ucol is None or icol is None:\n            raise ValueError('Could not identify user/item columns in LastFM data')\n        df = df.rename(columns={ucol: 'user', icol: 'item'})\n        if wcol is not None:\n            df = df[df[wcol] > 0].copy()\n        df['timestamp'] = np.arange(len(df))\n    else:\n        raise ValueError(name)\n\n    df['rating'] = 1.0\n    df = df[['user', 'item', 'rating', 'timestamp']].dropna().copy()\n    df['user'] = df['user'].astype(str)\n    df['item'] = df['item'].astype(str)\n    df = df.drop_duplicates(['user', 'item'])\n    return df\n\n\ndef core_filter(df, min_core=5):\n    while True:\n        ucnt = df['user'].value_counts()\n        icnt = df['item'].value_counts()\n        keep = df['user'].isin(ucnt[ucnt >= min_core].index) & df['item'].isin(icnt[icnt >= min_core].index)\n        new_df = df[keep].copy()\n        if len(new_df) == len(df):\n            return new_df\n        df = new_df\n\n\ndef make_user_holdout(df, seed, frac=0.2):\n    rng = np.random.default_rng(seed)\n    test_idx = []\n    for _, idx in df.groupby('user').groups.items():\n        idx = np.array(list(idx))\n        if len(idx) == 1:\n            test_idx.append(idx[0])\n            continue\n        ntest = max(1, int(np.ceil(len(idx) * frac)))\n        ntest = min(ntest, len(idx) - 1)\n        test_idx.extend(rng.choice(idx, size=ntest, replace=False).tolist())\n    test_idx = np.array(test_idx)\n    test = df.loc[test_idx].copy()\n    train = df.drop(index=test_idx).copy()\n    return train, test\n\n\ndef relevance_from_test(train, test):\n    rel = defaultdict(set)\n    train_users = set(train['user'].unique())\n    for u, i in test[['user', 'item']].itertuples(index=False):\n        if u in train_users:\n            rel[u].add(i)\n    users = sorted(rel.keys())\n    return rel, users\n\n\ndef rank_metrics(rec_df, rel, users, ks):\n    rec_map = {u: grp['item'].tolist() for u, grp in rec_df.groupby('user')}\n    rows = []\n    for k in ks:\n        ndcgs, precs = [], []\n        for u in users:\n            rec_items = rec_map.get(u, [])[:k]\n            gt = rel[u]\n            hits = np.array([1.0 if i in gt else 0.0 for i in rec_items], dtype=float)\n            precs.append(float(hits.mean()) if len(hits) else 0.0)\n            if len(hits) == 0:\n                ndcgs.append(0.0)\n            else:\n                gains = (2 ** hits - 1)\n                discounts = 1.0 / np.log2(np.arange(2, len(hits) + 2))\n                dcg = float(np.sum(gains * discounts))\n                ideal_hits = np.sort(hits)[::-1]\n                idcg = float(np.sum((2 ** ideal_hits - 1) * discounts))\n                ndcgs.append(dcg / idcg if idcg > 0 else 0.0)\n        rows.append({'k': k, 'ndcg': float(np.mean(ndcgs)) if ndcgs else 0.0, 'precision': float(np.mean(precs)) if precs else 0.0})\n    return pd.DataFrame(rows)\n\n\ndef run_algo(name, train):\n    if name == 'ALS':\n        model = BiasedMF(features=20, iterations=15, reg=0.1, damping=10)\n    elif name == 'ItemKNN':\n        model = ItemItem(nnbrs=40, min_nbrs=1, center=False)\n    elif name == 'Pop':\n        model = Popular()\n    else:\n        raise ValueError(name)\n    model.fit(train)\n    return model\n\nsummary_rows = []\nfor dname, cfg in datasets.items():\n    print(f'Loading {dname}...')\n    df = load_dataset(dname, cfg)\n    df = core_filter(df, min_core=5)\n    print(f'{dname}: {len(df)} interactions, {df.user.nunique()} users, {df.item.nunique()} items')\n\n    for seed in seeds:\n        train, test = make_user_holdout(df, seed)\n        rel, users = relevance_from_test(train, test)\n        if not users:\n            continue\n        for algo in alg_names:\n            print(f'Training {dname} | seed={seed} | {algo}')\n            model = run_algo(algo, train)\n            recs = recommend(model, users, 10)\n            metric_df = rank_metrics(recs, rel, users, ks)\n            for _, r in metric_df.iterrows():\n                summary_rows.append({'dataset': dname, 'seed': seed, 'algo': algo, 'k': int(r['k']), 'ndcg': r['ndcg'], 'precision': r['precision']})\n            experiment_data[dname]['per_seed'].append({'seed': seed, 'algo': algo, 'metrics': metric_df.to_dict('records')})\n            experiment_data[dname]['metrics']['val'].append(metric_df[['k', 'ndcg', 'precision']].to_numpy())\n            experiment_data[dname]['predictions'].append(recs[['user', 'item']].head(100).to_numpy())\n            experiment_data[dname]['ground_truth'].append(test[['user', 'item']].head(100).to_numpy())\n            experiment_data[dname]['losses']['val'].append(np.nan)\n            print('Epoch 1: validation_loss = nan')\n\nsummary = pd.DataFrame(summary_rows)\nsummary.to_csv(os.path.join(working_dir, 'summary_metrics.csv'), index=False)\nnp.save(os.path.join(working_dir, 'experiment_data.npy'), experiment_data, allow_pickle=True)\n\nstat_rows = []\nif len(summary):\n    for dname in summary['dataset'].unique():\n        for k in ks:\n            sub = summary[(summary['dataset'] == dname) & (summary['k'] == k)]\n            for metric in ['ndcg', 'precision']:\n                pivot = sub.pivot(index='seed', columns='algo', values=metric)\n                algs = list(pivot.columns)\n                for i in range(len(algs)):\n                    for j in range(i + 1, len(algs)):\n                        x = pivot[algs[i]].dropna().values\n                        y = pivot[algs[j]].dropna().values\n                        m = min(len(x), len(y))\n                        if m > 1:\n                            t = stats.ttest_rel(x[:m], y[:m], nan_policy='omit')\n                            stat_rows.append({'dataset': dname, 'k': k, 'metric': metric, 'a': algs[i], 'b': algs[j], 't': float(t.statistic), 'p': float(t.pvalue)})\n\nstat_df = pd.DataFrame(stat_rows)\nstat_df.to_csv(os.path.join(working_dir, 'stat_tests.csv'), index=False)\n\nprint('\\n=== Mean±Std over seeds ===')\nif len(summary):\n    print(summary.groupby(['dataset', 'algo', 'k'])[['ndcg', 'precision']].agg(['mean', 'std']).round(4))\nprint('\\n=== Paired t-tests ===')\nprint(stat_df.round(4) if len(stat_df) else 'No valid paired tests computed.')\n\n```", 'Execution Output': '```\nLoading MovieLens100K...\nMovieLens100K: 54413 interactions, 938 users, 1008 items\nTraining MovieLens100K | seed=11 | ALS\nNumba is using threading layer omp - consider TBB\nfound 1 potential runtime problems - see https://boi.st/lkpy-perf\nTraceback (most recent call last):\n  File "C:\\Users\\lukas\\AutoRecLab_Team7\\treesearch\\interpreter.py", line 147, in _run_session\n    exec(compile(code, self.agent_file_name, "exec"), global_scope)\n  File "runfile.py", line 171, in <module>\n  File "C:\\Users\\lukas\\AutoRecLab_Team7\\.venv\\Lib\\site-packages\\lenskit\\batch\\_recommend.py", line 88, in recommend\n    results = pd.concat(results, ignore_index=True, copy=False)\n              ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File "C:\\Users\\lukas\\AutoRecLab_Team7\\.venv\\Lib\\site-packages\\pandas\\core\\reshape\\concat.py", line 382, in concat\n    op = _Concatenator(\n         ^^^^^^^^^^^^^^\n  File "C:\\Users\\lukas\\AutoRecLab_Team7\\.venv\\Lib\\site-packages\\pandas\\core\\reshape\\concat.py", line 445, in __init__\n    objs, keys = self._clean_keys_and_objs(objs, keys)\n                 ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File "C:\\Users\\lukas\\AutoRecLab_Team7\\.venv\\Lib\\site-packages\\pandas\\core\\reshape\\concat.py", line 504, in _clean_keys_and_objs\n    objs_list = list(objs)\n                ^^^^^^^^^^\n  File "C:\\Users\\lukas\\AppData\\Roaming\\uv\\python\\cpython-3.11.9-windows-x86_64-none\\Lib\\concurrent\\futures\\process.py", line 620, in _chain_from_iterable_of_lists\n    for element in iterable:\n  File "C:\\Users\\lukas\\AppData\\Roaming\\uv\\python\\cpython-3.11.9-windows-x86_64-none\\Lib\\concurrent\\futures\\_base