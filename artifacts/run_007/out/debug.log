sv(p, sep='\\t')\n        cols = standardize_cols(raw)\n        user_col = cols.get('userid') or cols.get('user') or list(raw.columns)[0]\n        item_col = cols.get('artistid') or cols.get('artist') or cols.get('itemid') or list(raw.columns)[1]\n        if 'weight' in cols:\n            wcol = cols['weight']\n            df = raw[[user_col, item_col, wcol]].copy()\n            df.columns = ['user', 'item', 'rating']\n            df = df[df['rating'] > 0].copy()\n        else:\n            df = raw[[user_col, item_col]].copy()\n            df.columns = ['user', 'item']\n            df['rating'] = 1.0\n    else:\n        raise ValueError(name)\n    df['user'] = df['user'].astype(str)\n    df['item'] = df['item'].astype(str)\n    df = df.groupby(['user', 'item'], as_index=False)['rating'].max()\n    df['rating'] = 1.0\n    return df[['user', 'item', 'rating']]\n\n\ndef user_holdout_split(df, seed, frac=0.2):\n    rng = np.random.default_rng(seed)\n    train_parts, test_parts = [], []\n    for _, g in df.groupby('user'):\n        idx = g.index.to_numpy()\n        n_test = max(1, int(round(len(idx) * frac)))\n        n_test = min(n_test, len(idx) - 1) if len(idx) > 1 else 0\n        if n_test <= 0:\n            train_parts.append(g)\n            continue\n        test_idx = rng.choice(idx, size=n_test, replace=False)\n        train_idx = np.setdiff1d(idx, test_idx)\n        train_parts.append(df.loc[train_idx])\n        test_parts.append(df.loc[test_idx])\n    train = pd.concat(train_parts, ignore_index=True)\n    test = pd.concat(test_parts, ignore_index=True) if test_parts else pd.DataFrame(columns=df.columns)\n    return train, test\n\n\ndef build_algorithms():\n    return {\n        'Pop': basic.PopularityRecommender(),\n        'ItemKNN': basic.ItemItem(20),\n        'ALS': als.BiasedMF(features=20, iterations=15, reg=0.1),\n    }\n\n\ndef recommend_topk(algo, train, users, k=10):\n    try:\n        return topn.recommend(algo, train[['user', 'item']], users=users,