 \'timestamp\'})\\n\\n\\ndef load_lastfm(path=\'user_taggedartists-timestamps.dat\'):\\n    path = resolve_path(path)\\n    df = pd.read_csv(path, sep=\'\\\\t\')\\n    cols = {c.lower(): c for c in df.columns}\\n    u = cols.get(\'userid\', cols.get(\'user_id\', df.columns[0]))\\n    i = cols.get(\'artistid\', cols.get(\'item_id\', df.columns[1]))\\n    t = cols.get(\'timestamp\', df.columns[-1])\\n    df[\'rating\'] = 1.0\\n    return df[[u, i, \'rating\', t]].rename(columns={u: \'user\', i: \'item\', t: \'timestamp\'})\\n\\n\\ndef five_core(df):\\n    df = df.copy()\\n    changed = True\\n    while changed:\\n        changed = False\\n        uc = df[\'user\'].value_counts()\\n        ic = df[\'item\'].value_counts()\\n        keep = df[\'user\'].isin(uc[uc >= 5].index) & df[\'item\'].isin(ic[ic >= 5].index)\\n        if keep.sum() != len(df):\\n            df = df[keep].copy()\\n            changed = True\\n    return df.reset_index(drop=True)\\n\\n\\ndef remap_ids(df):\\n    out = df.copy()\\n    out[\'user\'] = pd.factorize(out[\'user\'])[0].astype(np.int32)\\n    out[\'item\'] = pd.factorize(out[\'item\'])[0].astype(np.int32)\\n    out[\'rating\'] = out[\'rating\'].astype(np.float32)\\n    return out\\n\\n\\ndef user_holdout_split(df, seed=42, frac=0.2):\\n    rng = np.random.default_rng(seed)\\n    test_idx = []\\n    for _, g in df.groupby(\'user\'):\\n        idx = g.index.to_numpy()\\n        n = max(1, int(np.ceil(len(idx) * frac)))\\n        chosen = rng.choice(idx, size=min(n, len(idx)), replace=False)\\n        test_idx.extend(chosen.tolist())\\n    test_idx = np.array(sorted(set(test_idx)))\\n    test = df.loc[test_idx].copy()\\n    train = df.drop(test_idx).copy()\\n    return train, test\\n\\n\\ndef build_algo(name):\\n    if name == \'Pop\':\\n        return Pop()\\n    if name == \'ALS\':\\n        if ALS is None:\\n            raise RuntimeError(\'ALS not available in installed LensKit\')\\n        for ctor in [\\n            lambda: ALS(features