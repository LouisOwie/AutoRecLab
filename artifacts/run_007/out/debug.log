ter(df, min_uc=5, min_ic=5):\\n    while True:\\n        ucounts = df.groupby(\'user\').size()\\n        keep_u = ucounts[ucounts >= min_uc].index\\n        df2 = df[df[\'user\'].isin(keep_u)].copy()\\n        icounts = df2.groupby(\'item\').size()\\n        keep_i = icounts[icounts >= min_ic].index\\n        df3 = df2[df2[\'item\'].isin(keep_i)].copy()\\n        if len(df3) == len(df):\\n            return df3.reset_index(drop=True)\\n        df = df3\\n\\n\\ndef load_dataset(name, meta):\\n    p = meta[\'path\']\\n    if name == \'MovieLens100K\':\\n        df = pd.read_csv(p, sep=\'\\\\t\', header=None, names=[\'user\', \'item\', \'rating\', \'timestamp\'])\\n        df = df[df[\'rating\'] > 3].copy()\\n        df = df[[\'user\', \'item\', \'rating\']]\\n    elif name == \'AmazonVideoGames\':\\n        df = pd.read_csv(p)\\n        cols = standardize_cols(df)\\n        user_col = cols.get(\'reviewerid\') or cols.get(\'userid\') or cols.get(\'reviewer_id\') or list(df.columns)[0]\\n        item_col = cols.get(\'asin\') or cols.get(\'itemid\') or cols.get(\'item_id\') or list(df.columns)[1]\\n        rating_col = cols.get(\'overall\') or cols.get(\'rating\') or list(df.columns)[2]\\n        df = df[[user_col, item_col, rating_col]].copy()\\n        df.columns = [\'user\', \'item\', \'rating\']\\n        df = df[df[\'rating\'] > 3].copy()\\n    elif name == \'LastFM\':\\n        raw = pd.read_csv(p, sep=\'\\\\t\')\\n        cols = standardize_cols(raw)\\n        user_col = cols.get(\'userid\') or cols.get(\'user\') or list(raw.columns)[0]\\n        item_col = cols.get(\'artistid\') or cols.get(\'artist\') or cols.get(\'itemid\') or list(raw.columns)[1]\\n        if \'weight\' in cols:\\n            wcol = cols[\'weight\']\\n            df = raw[[user_col, item_col, wcol]].copy()\\n            df.columns = [\'user\', \'item\', \'rating\']\\n            df = df[df[\'rating\'] > 0].copy()\\n        else:\\n            df = raw[[user_col, item_col]].copy()\\n           