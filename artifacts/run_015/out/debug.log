\n    os.path.join(os.getcwd(), \'u.data\'),\\n    os.path.join(os.getcwd(), \'ml-100k\', \'u.data\'),\\n    os.path.join(working_dir, \'u.data\')\\n]\\nfile_path = None\\nfor p in candidate_paths:\\n    if os.path.exists(p):\\n        file_path = p\\n        break\\nif file_path is None:\\n    raise FileNotFoundError(\'Could not find u.data in expected locations.\')\\n\\n# Load data\\nratings = pd.read_csv(file_path, sep=\'\\\\t\', header=None, names=[\'user_id\', \'item_id\', \'rating\', \'timestamp\'])\\n\\n# Basic summaries\\nunique_users = ratings[\'user_id\'].nunique()\\nunique_items = ratings[\'item_id\'].nunique()\\nuser_counts = ratings[\'user_id\'].value_counts()\\ntop3_users = user_counts.head(3)\\nmost_active_user = top3_users.index[0]\\nmost_active_user_mean_rating = ratings.loc[ratings[\'user_id\'] == most_active_user, \'rating\'].mean()\\n\\n# Item co-occurrence: users rating both 50 and 181\\nusers_item_50 = set(ratings.loc[ratings[\'item_id\'] == 50, \'user_id\'])\\nusers_item_181 = set(ratings.loc[ratings[\'item_id\'] == 181, \'user_id\'])\\nco_occurrence = len(users_item_50 & users_item_181)\\n\\n# Timestamp range check for MovieLens 100k expected collection range (1997-1998)\\n# Use unix timestamps spanning roughly Sep 1997 to Apr 1998.\\nexpected_min = pd.Timestamp(\'1997-09-20\').timestamp()\\nexpected_max = pd.Timestamp(\'1998-04-30 23:59:59\').timestamp()\\nout_of_range = ratings[(ratings[\'timestamp\'] < expected_min) | (ratings[\'timestamp\'] > expected_max)]\\nnum_out_of_range = len(out_of_range)\\n\\n# Save computed values\\nexperiment_data[\'movielens100k\'][\'extra\'] = {\\n    \'file_path\': file_path,\\n    \'unique_users\': int(unique_users),\\n    \'unique_items\': int(unique_items),\\n    \'top3_users\': {int(k): int(v) for k, v in top3_users.to_dict().items()},\\n    \'most_active_user\': int(most_active_user),\\n    \'most_active_user_mean_rating\': float(most_active_user_mean_rating),\\n    \'co_occurrence_item_50_181\': int(co_occurrence),\\n    \'expected_timestamp_min\': float(expected_min),\\n    \'expected_timestamp_max\': float(expected_max),\\n    \'num_out_of_range_timestamps\': int(num_out_of_range),\\n}\\n\\n# Put key results into metrics for persistence\\nexperiment_data[\'movielens100k\'][\'metrics\'][\'val\'].append({\\n    \'unique_users\': int(unique_users),\\n    \'unique_items\': int(unique_items),\\n    \'co_occurrence_item_50_181\': int(co_occurrence),\\n    \'num_out_of_range_timestamps\': int(num_out_of_range)\\n})\\n\\n# Print requested outputs\\nprint(f\'Unique user_ids: {unique_users}\')\\nprint(f\'Unique item_ids: {unique_items}\')\\nprint(\'Top 3 most active users (user_id: rating_count):\')\\nfor uid, cnt in top3_users.items():\\n    print(f\'  {uid}: {cnt}\')\\nprint(f\'Mean rating for most active user {most_active_user}: {most_active_user_mean_rating:.4f}\')\\nprint(f\'Users who rated both item 50 and item 181: {co_occurrence}\')\\nprint(f\'Out-of-range timestamps: {num_out_of_range}\')\\nif num_out_of_range > 0:\\n    print(\'Example out-of-range timestamps:\')\\n    print(out_of_range.head().to_string(index=False))\\nelse:\\n    print(\'No timestamps outside the expected 1997-1998 range were found.\')\\n\\n# Visualization\\nplt.figure(figsize=(7, 4))\\nplt.bar([str(u) for u in top3_users.index], top3_users.values)\\nplt.xlabel(\'User ID\')\\nplt.ylabel(\'Rating Count\')\\nplt.title(\'MovieLens100k Top 3 Active Users\')\\nplt.tight_layout()\\nplot_path = os.path.join(working_dir, \'movielens100k_top3_active_users.png\')\\nplt.savefig(plot_path, dpi=150)\\nplt.close()\\n\\n# Save all experiment data\\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\\n"}', name='return_plan_and_code'), type='function')]))[/cyan]
