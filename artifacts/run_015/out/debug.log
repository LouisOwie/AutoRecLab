'train\': [], \'val\': []},\\n        \'losses\': {\'train\': [], \'val\': []},\\n        \'predictions\': [],\\n        \'ground_truth\': [],\\n        \'timestamps\': [],\\n    }\\n}\\n\\n# Locate u.data\\ncandidate_paths = [\\n    os.path.join(os.getcwd(), \'u.data\'),\\n    os.path.join(os.getcwd(), \'ml-100k\', \'u.data\'),\\n    os.path.join(working_dir, \'u.data\'),\\n]\\ndata_path = next((p for p in candidate_paths if os.path.exists(p)), None)\\nif data_path is None:\\n    raise FileNotFoundError(\'Could not find u.data in expected locations.\')\\n\\ncols = [\'user_id\', \'item_id\', \'rating\', \'timestamp\']\\ndf = pd.read_csv(data_path, sep=\'\\\\t\', names=cols, engine=\'python\')\\ndf[\'user_id\'] = df[\'user_id\'].astype(int)\\ndf[\'item_id\'] = df[\'item_id\'].astype(int)\\ndf[\'rating\'] = df[\'rating\'].astype(float)\\ndf[\'timestamp\'] = df[\'timestamp\'].astype(int)\\n\\n# Basic dataset statistics\\nn_users = df[\'user_id\'].nunique()\\nn_items = df[\'item_id\'].nunique()\\nuser_counts = df.groupby(\'user_id\').size().sort_values(ascending=False)\\ntop3_users = user_counts.head(3)\\ntop1_user = int(top3_users.index[0])\\ntop1_mean_rating = df.loc[df[\'user_id\'] == top1_user, \'rating\'].mean()\\n\\n# Item co-occurrence: users who rated both item 50 and item 181\\nusers_50 = set(df.loc[df[\'item_id\'] == 50, \'user_id\'].unique())\\nusers_181 = set(df.loc[df[\'item_id\'] == 181, \'user_id\'].unique())\\nco_occurrence = len(users_50 & users_181)\\n\\n# Timestamp range check for MovieLens 100k era (1997-1998)\\n# Conservative Unix time window: 1997-09-01 through 1998-04-30\\nstart_ts = int(pd.Timestamp(\'1997-09-01\', tz=\'UTC\').timestamp())\\nend_ts = int(pd.Timestamp(\'1998-04-30 23:59:59\', tz=\'UTC\').timestamp())\\noutside = df[(df[\'timestamp\'] < start_ts) | (df[\'timestamp\'] > end_ts)]\\n\\n# LensKit-compatible interaction frame and normalization for a simple baseline pipeline\\n# Normalize ratings to [0, 1] for model input stability\\nmin_r, max_r = df[\'rating\'].min(), df[\'rating\'].max()\\ndf[\'rating_norm\'] = (df[\'rating\'] - min_r) / (max_r - min_r) if max_r > min_r else 0.0\\n\\n# Simple train/validation split per-user (last interaction to validation when possible)\\ndf_sorted = df.sort_values([\'user_id\', \'timestamp\', \'item_id\']).copy()\\ntrain_idx = []\\nval_idx = []\\nfor uid, g in df_sorted.groupby(\'user_id\', sort=False):\\n    if len(g) >= 2:\\n        val_idx.append(g.index[-1])\\n        train_idx.extend(g.index[:-1].tolist())\\n    else:\\n        train_idx.extend(g.index.tolist())\\ntrain_df = df_sorted.loc[train_idx].copy()\\nval_df = df_sorted.loc[val_idx].copy() if len(val_idx) else pd.DataFrame(columns=df.columns)\\n\\n# Simple baseline: item mean on normalized ratings\\nitem_mean = train_df.groupby(\'item_id\')[\'rating_norm\'].mean()\\nglobal_mean = train_df[\'rating_norm\'].mean()\\ntrain_pred = train_df[\'item_id\'].map(item_mean).fillna(global_mean).to_numpy()\\nval_pred = val_df[\'item_id\'].map(item_mean).fillna(global_mean).to_numpy() if len(val_df) else np.array([])\\ntrain_rmse = float(np.sqrt(np.mean((train_df[\'rating_norm\'].to_numpy() - train_pred) ** 2))) if len(train_df) else np.nan\\nval_rmse = float(np.sqrt(np.mean((val_df[\'rating_norm\'].to_numpy() - val_pred) ** 2))) if len(val_df) else np.nan\\n\\nexperiment_data[\'movielens100k\'][\'metrics\'][\'train\'].append({\'epoch\': 1, \'rmse\': train_rmse})\\nexperiment_data[\'movielens100k\'][\'metrics\'][\'val\'].append({\'epoch\': 1, \'rmse\': val_rmse})\\nexperiment_data[\'movielens100k\'][\'losses\'][\'train\'].append({\'epoch\': 1, \'loss\': train_rmse})\\nexperiment_data[\'movielens100k\'][\'losses\'][\'val\'].append({\'epoch\': 1, \'loss\': val_rmse})\\nexperiment_data[\'movielens100k\'][\'predictions\'] = val_pred\\nexperiment_data[\'movielens100k\'][\'ground_truth\'] = val_df[\'rating_norm\'].to_numpy() if len(val_df) else np.array([])\\nexperiment_data[\'movielens100k\'][\'timestamps\'] = df[\'timestamp\'].to_numpy()\\n\\nprint(f\'Total unique users: {n_users}\')\\nprint(f\'Total unique items: {n_items}\')\\nprint(\'Top 3 most active users (user_id: count):\')\\nfor uid, cnt in top3_users.items():\\n    print(f\'  {uid}: {int(cnt)}\')\\nprint(f\'Mean rating for most active user {top1_user}: {top1_mean_rating:.4f}\')\\nprint(f\'Users who rated both item 50 and item 181: {co_occurrence}\')\\nprint(f\'Timestamps outside expected 1997-1998 range: {len(outside)}\')\\nif len(outside):\\n    print(f\'  min_outside_timestamp={outside[\\"timestamp\\"].min()}, max_outside_timestamp={outside[\\"timestamp\\"].max()}\')\\n\\nprint(f\'Epoch 1: validation_loss = {val_rmse:.4f}\')\\n\\n# Save arrays and metrics\\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\\nnp.save(os.path.join(working_dir, \'movielens100k_val_predictions.npy\'), experiment_data[\'movielens100k\'][\'predictions\'])\\nnp.save(os.path.join(working_dir, \'movielens100k_val_ground_truth.npy\'), experiment_data[\'movielens100k\'][\'ground_truth\'])\\nnp.save(os.path.join(working_dir, \'movielens100k_timestamps.npy\'), experiment_data[\'movielens100k\'][\'timestamps\'])\\n"}', name='return_plan_and_code'), type='function')]))[/cyan]
