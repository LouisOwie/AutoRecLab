 p in candidate_paths:\n    if os.path.exists(p):\n        input_path = p\n        break\n\nif input_path is None:\n    raise FileNotFoundError('Could not locate u.data in common paths.')\n\n# Load data\ncols = ['user_id', 'item_id', 'rating', 'timestamp']\ndf = pd.read_csv(input_path, sep='\\t', names=cols, engine='python')\n\n# Basic counts\nunique_users = df['user_id'].nunique()\nunique_items = df['item_id'].nunique()\n\n# Top 3 active users\nuser_counts = df.groupby('user_id').size().sort_values(ascending=False)\ntop3_users = user_counts.head(3)\nmost_active_user = int(top3_users.index[0])\nmost_active_user_mean_rating = float(df.loc[df['user_id'] == most_active_user, 'rating'].mean())\n\n# Co-occurrence of item 50 and 181\nusers_item50 = set(df.loc[df['item_id'] == 50, 'user_id'].astype(int).tolist())\nusers_item181 = set(df.loc[df['item_id'] == 181, 'user_id'].astype(int).tolist())\ncooccurrence_count = len(users_item50 & users_item181)\n\n# Timestamp validity check\n# MovieLens 100k timestamps are from Sep 1997 to Apr 1998.\nmin_ts = int(df['timestamp'].min())\nmax_ts = int(df['timestamp'].max())\nmin_dt = pd.to_datetime(min_ts, unit='s', utc=True)\nmax_dt = pd.to_datetime(max_ts, unit='s', utc=True)\nexpected_start = pd.Timestamp('1997-09-01', tz='UTC')\nexpected_end = pd.Timestamp('1998-04-30 23:59:59', tz='UTC')\noutside_range_mask = (pd.to_datetime(df['timestamp'], unit='s', utc=True) < expected_start) | (pd.to_datetime(df['timestamp'], unit='s', utc=True) > expected_end)\noutside_range_count = int(outside_range_mask.sum())\n\n# Save summary data\nexperiment_data['movielens100k_u_data']['summary'] = {\n    'input_path': input_path,\n    'unique_users': int(unique_users),\n    'unique_items': int(unique_items),\n    'top3_users': top3_users.astype(int).to_dict(),\n    'most_active_user': most_active_user,\n    'most_active_user_mean_rating': most_active_user_mean_rating,\n    'item_50_181_cooccurrence': int(cooccurrence_count),\n    'timestamp_min_unix': min_ts,\n    'timestamp_max_unix': max_ts,\n    'timestamp_min_utc': str(min_dt),\n    'timestamp_max_utc': str(max_dt),\n    'outside_expected_range_count': outside_range_count,\n}\n\n# Save arrays for traceability\nnp.save(os.path.join(working_dir, 'experiment_data.npy'), experiment_data, allow_pickle=True)\nnp.save(os.path.join(working_dir, 'movielens100k_unique_users.npy'), np.array([unique_users], dtype=np.int64))\nnp.save(os.path.join(working_dir, 'movielens100k_unique_items.npy'), np.array([unique_items], dtype=np.int64))\nnp.save(os.path.join(working_dir, 'movielens100k_top3_user_counts.npy'), top3_users.to_numpy(dtype=np.int64))\nnp.save(os.path.join(working_dir, 'movielens100k_top3_user_ids.npy'), top3_users.index.to_numpy(dtype=np.int64))\nnp.save(os.path.join(working_dir, 'movielens100k_item50_181_cooccurrence.npy'), np.array([cooccurrence_count], dtype=np.int64))\nnp.save(os.path.join(working_dir, 'movielens100k_outside_timestamp_count.npy'), np.array([outside_range_count], dtype=np.int64))\n\nprint(f'Loaded: {input_path}')\nprint(f'Unique user_ids: {unique_users}')\nprint(f'Unique item_ids: {unique_items}')\nprint('Top 3 most active users (user_id: rating_count):')\nfor uid, cnt in top3_users.items():\n    print(f'  {int(uid)}: {int(cnt)}')\nprint(f'Most active user {most_active_user} mean rating: {most_active_user_mean_rating:.4f}')\nprint(f'Users who rated both item 50 and item 181: {cooccurrence_count}')\nprint(f'Timestamp range observed: {min_dt} to {max_dt}')\nprint(f'Timestamps outside expected 1997-1998 range: {outside_range_count}')\n\n```", 'Execution Output': '```\nLoaded: C:\\Users\\lukas\\AutoRecLab_Team7\\workspace\\u.data\nUnique user_ids: 943\nUnique item_ids: 1682\nTop 3 most active users (user_id: rating_count):\n  405: 737\n  655: 685\n  13: 636\nMost active user 405 mean rating: 1.8345\nUsers who rated both item 50 and item 181: 480\nTimestamp range observed: 1997-09-20 03:05:10+00:00 to 1998-04-22 23:10:38+00:00\nTimestamps outside e