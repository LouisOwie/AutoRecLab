em biases\n    for it, group in train_df.groupby(\'item_id\'):\n        res = group[\'rating\'] - (global_mean + train_df[\'user_id\'].map(lambda uid: user_bias.get(uid, 0.0)))\n        # For per-item adjustment, subtract user bias for each rating\'s user\n        res = group[\'rating\'] - (global_mean + group[\'user_id\'].map(lambda uid: user_bias.get(uid, 0.0)))\n        item_bias[it] = res.mean() if len(res) > 0 else 0.0\n\n    # Compute training RMSE\n    train_preds = train_df.apply(lambda row: predict(row[\'user_id\'], row[\'item_id\']), axis=1)\n    train_rmse = sqrt(np.mean((train_df[\'rating\'].values - train_preds.values)**2))\n    train_rmse_list.append(train_rmse)\n\n    # Compute validation RMSE\n    val_preds = val_df.apply(lambda row: predict(row[\'user_id\'], row[\'item_id\']), axis=1)\n    val_rmse = sqrt(np.mean((val_df[\'rating\'].values - val_preds.values)**2))\n    val_rmse_list.append(val_rmse)\n    print(f"Epoch {epoch+1}: validation_rmse = {val_rmse:.4f}")\n\n# Save metrics and data\nexperiment_data = {\n    \'ml100k\': {\n        \'metrics\': {\'train\': train_rmse_list, \'val\': val_rmse_list},\n        \'losses\': {\'train\': [], \'val\': []},\n        \'predictions\': [],\n        \'ground_truth\': [],\n    }\n}\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\nprint("Experiment data saved to", os.path.join(working_dir, \'experiment_data.npy\'))\n\n```'}
