[2026/05/14 14:42:26] [DEBUG] isgsa.llm: prompt content: {'Code': '```python\nimport os\nimport numpy as np\nimport pandas as pd\n\n# Setup working directory (as required by the execution environment guidelines)\nworking_dir = os.path.join(os.getcwd(), \'working\')\nos.makedirs(working_dir, exist_ok=True)\n\nCANDIDATE_PATHS = [\n    os.path.join(\'ml-100k\', \'u.data\'),\n    os.path.join(\'ml-100k\', \'u.data.gz\'),\n    \'u.data\',\n    os.path.join(\'data\', \'ml-100k\', \'u.data\'),\n]\npath = None\nfor p in CANDIDATE_PATHS:\n    if os.path.exists(p):\n        path = p\n        break\nif path is None:\n    raise FileNotFoundError("Could not find u.data. Please place MovieLens ml-100k data in one of: {}".format(CANDIDATE_PATHS))\n\n# Try to import lenskit and use if available (best-effort). If not available, fall back to pandas.\nuse_lenskit = False\ntry:\n    from lenskit.data import MovieLens  # type: ignore\n    # If this import works, we will attempt to use it to load the file; otherwise, fall back.\n    use_lenskit = True\nexcept Exception:\n    use_lenskit = False\n\ncols = [\'user_id\', \'item_id\', \'rating\', \'timestamp\']\n\ndef load_data(path: str) -> pd.DataFrame:\n    # Load with strict integer dtypes and whitespace-delimited parsing\n    try:\n        df = pd.read_csv(\n            path,\n            sep=r\'\\s+\',\n            engine=\'python\',\n            header=None,\n            names=cols,\n            dtype={\'user_id\': int, \'item_id\': int, \'rating\': int, \'timestamp\': int},\n            on_bad_lines=\'error\',  # raise on malformed lines\n        )\n    except pd.errors.ParserError as e:\n        raise ValueError("Malformed input line encountered during parsing: {}".format(e))\n    except FileNotFoundError:\n        raise\n    return df\n\n# Load and validate data\nif use_lenskit:\n    # Best-effort attempt; if it fails, fall back to pandas loading and continue.\n    try:\n        # Some LensKit versions provide a MovieLens loader; use it if available\n        df = load_data(path)\n    except Exception:\n        df = load_data(path)\nelse:\n    df = load_data(path)\n\n# Basic statistics\nn_users = int(df[\'user_id\'].nunique())\nn_items = int(df[\'item_id\'].nunique())\n\n# Top-3 most active users by rating count with deterministic tie-break (count desc, user_id asc)\nuser_counts = df.groupby(\'user_id\').size().reset_index(name=\'count\')\ntop3_df = user_counts.sort_values([\'count\', \'user_id\'], ascending=[False, True]).head(3)\ntop3_list = [\n    {\'user_id\': int(r[\'user_id\']), \'count\': int(r[\'count\'])}\n    for _, r in top3_df.iterrows()\n]\n\n# Mean rating for the #1 user (if exists)\nmean_top1 = None\nif not top3_df.empty:\n    top1_user = int(top3_df.iloc[0][\'user_id\'])\n    mean_top1 = float(df.loc[df[\'user_id\'] == top1_user, \'rating\'].mean())\n\n# Co-occurrence for items 50 and 181\nusers_who_rated_50 = set(df.loc[df[\'item_id\'] == 50, \'user_id\'])\nusers_who_rated_181 = set(df.loc[df[\'item_id\'] == 181, \'user_id\'])\ncooccurrence_50_181 = len(users_who_rated_50 & users_who_rated_181)\n\n# Timestamp range check (1997-01-01 to 1998-12-31)\nts = pd.to_datetime(df[\'timestamp\'], unit=\'s\', utc=True)\nstart = pd.Timestamp(\'1997-01-01\', tz=\'UTC\')\nend = pd.Timestamp(\'1998-12-31 23:59:59\', tz=\'UTC\')\nout_mask = (ts < start) | (ts > end)\nout_of_range_count = int(out_mask.sum())\nout_of_range_sample = df.loc[out_mask, [\'user_id\',\'item_id\',\'rating\',\'timestamp\']].head(5).to_dict(\'records\')\n\nsummary = {\n    \'total_users\': n_users,\n    \'total_items\': n_items,\n    \'top3_users\': top3_list,\n    \'mean_rating_top1\': mean_top1,\n    \'cooccurrence_50_181\': cooccurrence_50_181,\n    \'out_of_range_timestamp_count\': out_of_range_count,\n    \'out_of_range_sample\': out_of_range_sample,\n}\n\n# Persist a reproducible record to working_dir\nexperiment_data = {\n    \'ml100k_u_data_analysis\': {\n        \'summary\': summary\n    }\n}\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\n\n# Print a concise human-readable summary\nprint("Unique users:", n_users)\nprint("Unique items:", n_items)\nprint("Top-3 active users (id, count):", [(r[\'user_id\'], r[\'count\']) for r in top3_list])\nif mean_top1 is not None:\n    print(f"Mean rating for top user {top3_df.iloc[0][\'user_id\']}: {mean_top1:.4f}")\nprint("Co-occurrence (users who rated both 50 and 181):", cooccurrence_50_181)\nprint("Timestamps outside 1997-1998: ", out_of_range_count)\nif out_of_range_sample:\n    print("Sample outside range:", out_of_range_sample[:5])\n\n```'}
