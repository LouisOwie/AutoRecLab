item_id\trating\ttimestamp\ncols = [\'user_id\', \'item_id\', \'rating\', \'timestamp\']\ndf = pd.read_csv(path, sep=\'\\t\', names=cols, header=None, engine=\'python\')\ndf[\'user_id\'] = df[\'user_id\'].astype(int)\ndf[\'item_id\'] = df[\'item_id\'].astype(int)\ndf[\'rating\'] = df[\'rating\'].astype(float)\ndf[\'timestamp\'] = df[\'timestamp\'].astype(int)\n\n# Basic dataset statistics\nn_users = int(df[\'user_id\'].nunique())\nn_items = int(df[\'item_id\'].nunique())\nprint(f"Unique users: {n_users}")\nprint(f"Unique items: {n_items}")\n\n# Top 3 most active users by rating count\nuser_counts = df.groupby(\'user_id\').size().sort_values(ascending=False)\ntop3 = user_counts.head(3)\nprint("Top 3 most active users (by rating count):")\nfor rank, (uid, cnt) in enumerate(top3.items(), start=1):\n    print(f"  {rank}. user {uid} - {cnt} ratings")\n# mean rating for the#1 user\ntop_user = top3.index[0]\nmean_top_user = df.loc[df[\'user_id\'] == top_user, \'rating\'].mean()\nprint(f"Mean rating for top user {top_user}: {mean_top_user:.4f}")\n\n# Co-occurrence for items 50 and 181\nu50 = set(df.loc[df[\'item_id\'] == 50, \'user_id\'])\nu181 = set(df.loc[df[\'item_id\'] == 181, \'user_id\'])\ncooccurrence = len(u50 & u181)\nprint(f"Co-occurrence (users who rated both Item 50 and Item 181): {cooccurrence}")\n\n# Timestamp range check (1997-01-01 to 1998-12-31)\ndt = pd.to_datetime(df[\'timestamp\'], unit=\'s\', utc=True).dt.tz_convert(None)\noutside = df.loc[(pd.to_datetime(df[\'timestamp\'], unit=\'s\') < pd.Timestamp(\'1997-01-01\')) | (pd.to_datetime(df[\'timestamp\'], unit=\'s\') > pd.Timestamp(\'1998-12-31\'))]\nprint(f"Timestamps outside 1997-1998: {len(outside)} entries")\nif len(outside) > 0:\n    print("Sample outside range:")\n    sample = outside[[\'user_id\',\'item_id\',\'rating\',\'timestamp\']].head()\n    print(sample)\n\n# Simple baseline: global mean + per-user bias + per-item bias (coordinate descent)\n# Train/test split: 80/20 random\nrand_state = 42\ndf = df.sample(frac=1, random_state=rand_state).reset_index(drop=True)\nn = len(df)\ntrain_frac = 0.8\nn_train = int(n * train_frac)\ntrain_df = df.iloc[:n_train].copy()\nval_df = df.iloc[n_train:].copy()\n\nglobal_mean = train_df[\'rating\'].mean()\n\n# Bias arrays using dicts\nuser_bias = {u: 0.0 for u in train_df[\'user_id\'].unique()}\nitem_bias = {i: 0.0 for i in train_df[\'item_id\'].unique()}\n\n# Prepare grouped indices for faster updates\nuser_to_ratings = train_df.groupby(\'user_id\')\nitem_to_ratings = train_df.groupby(\'item_id\')\n\ndef predict(u, i):\n    bu = user_bias.get(u, 0.0)\n    bi = item_bias.get(i, 0.0)\n    pred = global_mean + bu + bi\n    if pred < 1.0:\n        pred = 1.0\n    if pred > 5.0:\n        pred = 5.0\n    return pred\n\n# Training loop (coordinate descent style)\nepochs = 6\nval_rmse_list = []\ntrain_rmse_list = []\nfrom math import sqrt\n\nfor epoch in range(epochs):\n    # Update user biases\n    for u, group in train_df.groupby(\'user_id\'):\n        # residuals: rating - (global_mean + item_bias[item])\n        res = group[\'rating\'] - (global_mean + group[\'item_id\'].map(item_bias))\n        user_bias[u] = res.mean() if len(res) > 0 else 0.0\n    # Update item biases\n    for it, group in train_df.groupby(\'item_id\'):\n        res = group[\'rating\'] - (global_mean + train_df[\'user_id\'].map(lambda uid: user_bias.get(uid, 0.0)))\n        # For per-item adjustment, subtract user bias for each rating\'s user\n        res = group[\'rating\'] - (global_mean + group[\'user_id\'].map(lambda uid: user_bias.get(uid, 0.0)))\n        item_bias[it] = res.mean() if len(res) > 0 else 0.0\n\n    # Compute training RMSE\n    train_preds = train_df.apply(lambda row: predict(row[\'user_id\'], row[\'item_id\']), axis=1)\n    train_rmse = sqrt(np.mean((train_df[\'rating\'].values - train_preds.values)**2))\n    train_rmse_list.append(train_rmse)\n\n    # Compute validation RMSE\n    val_preds = val_df.apply(lambda row: predict(row[\'user_