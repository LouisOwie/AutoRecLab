ics\': {\'train\': [], \'val\': []},\\n        \'losses\': {\'train\': [], \'val\': []},\\n        \'predictions\': [],\\n        \'ground_truth\': [],\\n        \'extra\': {}\\n    }\\n}\\n\\n# -----------------------------\\n# Load data\\n# -----------------------------\\ndata_path = os.path.join(os.getcwd(), \'u.data\')\\nif not os.path.exists(data_path):\\n    alt_path = os.path.join(os.getcwd(), \'ml-100k\', \'u.data\')\\n    if os.path.exists(alt_path):\\n        data_path = alt_path\\n    else:\\n        raise FileNotFoundError(\'Could not find u.data in the current directory or ./ml-100k/u.data\')\\n\\ncols = [\'user_id\', \'item_id\', \'rating\', \'timestamp\']\\ndf = pd.read_csv(data_path, sep=\'\\\\t\', names=cols, engine=\'python\')\\n\\n# -----------------------------\\n# Core statistics\\n# -----------------------------\\nunique_users = df[\'user_id\'].nunique()\\nunique_items = df[\'item_id\'].nunique()\\nuser_counts = df.groupby(\'user_id\').size().sort_values(ascending=False)\\ntop3_users = user_counts.head(3)\\nmost_active_user = top3_users.index[0]\\nmost_active_user_mean_rating = df.loc[df[\'user_id\'] == most_active_user, \'rating\'].mean()\\n\\n# Items 50 and 181 co-occurrence: users who rated both\\nusers_item50 = set(df.loc[df[\'item_id\'] == 50, \'user_id\'].unique())\\nusers_item181 = set(df.loc[df[\'item_id\'] == 181, \'user_id\'].unique())\\nco_occurrence_50_181 = len(users_item50 & users_item181)\\n\\n# Timestamp range check for MovieLens 100k expected around 1997-1998\\n# Use a broad but strict window: 1997-01-01 through 1998-12-31 UTC-like Unix seconds\\nexpected_start = pd.Timestamp(\'1997-01-01\').timestamp()\\nexpected_end = pd.Timestamp(\'1998-12-31 23:59:59\').timestamp()\\noutside_mask = (df[\'timestamp\'] < expected_start) | (df[\'timestamp\'] > expected_end)\\noutside_count = int(outside_mask.sum())\\noutside_timestamps = df.loc[outside_mask, \'timestamp\'].to_numpy()\\n\\n# Convert timestamp summary for inspection\\nmin_ts = int(df[\'timestamp\'].min())\\nmax_ts = int(df[\'timestamp\'].max())\\nmin_dt = pd.to_datetime(min_ts, unit=\'s\')\\nmax_dt = pd.to_datetime(max_ts, unit=\'s\')\\n\\n# -----------------------------\\n# Save metrics in experiment_data\\n# -----------------------------\\nexperiment_data[\'ml100k\'][\'extra\'] = {\\n    \'unique_users\': int(unique_users),\\n    \'unique_items\': int(unique_items),\\n    \'top3_users\': top3_users.to_dict(),\\n    \'most_active_user\': int(most_active_user),\\n    \'most_active_user_mean_rating\': float(most_active_user_mean_rating),\\n    \'co_occurrence_item_50_181\': int(co_occurrence_50_181),\\n    \'timestamp_min\': int(min_ts),\\n    \'timestamp_max\': int(max_ts),\\n    \'timestamp_min_datetime\': str(min_dt),\\n    \'timestamp_max_datetime\': str(max_dt),\\n    \'outside_timestamp_count\': outside_count,\\n    \'outside_timestamps_sample\': outside_timestamps[:10].tolist(),\\n}\\n\\n# Save plottable arrays\\nexperiment_data[\'ml100k\'][\'metrics\'][\'train\'].append(np.array([unique_users, unique_items], dtype=np.int64))\\nexperiment_data[\'ml100k\'][\'metrics\'][\'val\'].append(np.array([top3_users.iloc[0], top3_users.iloc[1], top3_users.iloc[2]], dtype=np.int64))\\nexperiment_data[\'ml100k\'][\'losses\'][\'train\'].append(np.array([most_active_user_mean_rating], dtype=np.float64))\\nexperiment_data[\'ml100k\'][\'losses\'][\'val\'].append(np.array([co_occurrence_50_181], dtype=np.float64))\\nexperiment_data[\'ml100k\'][\'predictions\'] = np.array([], dtype=np.float32)\\nexperiment_data[\'ml100k\'][\'ground_truth\'] = np.array([], dtype=np.float32)\\n\\n# -----------------------------\\n# Visualizations\\n# -----------------------------\\nplt.figure(figsize=(7, 4))\\nplt.hist(user_counts.values, bins=30, color=\'steelblue\', edgecolor=\'black\')\\nplt.title(\'MovieLens100k User Rating Count Distribution\')\\nplt.xlabel(\'Ratings per user\')\\nplt.ylabel(\'Count of users\')\\nplt.tight_layout()\\nplt.savefig(os.path.join(working_