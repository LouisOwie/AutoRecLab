orithms.basic import Popular\nfrom lenskit.algorithms.item_knn import ItemItem\nfrom lenskit.algorithms.als import BiasedMF\n\nnp.random.seed(42)\nwarnings.filterwarnings(\'ignore\')\n\nDATA_FILES = {\n    \'MovieLens100K\': \'u.data\',\n    \'AmazonVideoGames\': \'VideoGames.csv\',\n    \'LastFM\': \'user_taggedartists-timestamps.dat\',\n}\nSEEDS = [11, 22, 33, 44, 55]\nKS = [1, 5, 10]\nALGS = [\'ALS\', \'ItemKNN\', \'Pop\']\n\nexperiment_data = {\n    d: {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': [], \'results\': []}\n    for d in DATA_FILES\n}\n\n\ndef normalize_id_series(s):\n    return s.astype(str).str.strip()\n\n\ndef load_movielens(path):\n    df = pd.read_csv(path, sep=\'\\t\', names=[\'user\', \'item\', \'rating\', \'ts\'], engine=\'python\')\n    df[\'user\'] = normalize_id_series(df[\'user\'])\n    df[\'item\'] = normalize_id_series(df[\'item\'])\n    df = df[df[\'rating\'] > 3].copy()\n    df[\'rating\'] = 1.0\n    return df[[\'user\', \'item\', \'rating\']]\n\n\ndef load_amazon(path):\n    df = pd.read_csv(path)\n    cols = {c.lower(): c for c in df.columns}\n    user_col = cols.get(\'reviewerid\', cols.get(\'user_id\', list(df.columns)[0]))\n    item_col = cols.get(\'asin\', cols.get(\'item_id\', list(df.columns)[1]))\n    rating_col = cols.get(\'overall\', cols.get(\'rating\', None))\n    if rating_col is None:\n        raise ValueError(\'Could not infer rating column for AmazonVideoGames\')\n    df = df[[user_col, item_col, rating_col]].rename(columns={user_col: \'user\', item_col: \'item\', rating_col: \'rating\'})\n    df[\'user\'] = normalize_id_series(df[\'user\'])\n    df[\'item\'] = normalize_id_series(df[\'item\'])\n    df = df[df[\'rating\'] > 3].copy()\n    df[\'rating\'] = 1.0\n    return df[[\'user\', \'item\', \'rating\']]\n\n\ndef load_lastfm(path):\n    df = pd.read_csv(path, sep=\'\\t\', engine=\'python\')\n    cols = {c.lower(): c for c in df.columns}\n    user_col = cols.get(\'user\', cols.get(\'userid\', list(df.columns)[0]))\n    item_col = cols.get(\'artistid\', cols.get(\'item\', list(df.columns)[1]))\n    df = df[[user_col, item_col]].rename(columns={user_col: \'user\', item_col: \'item\'})\n    df[\'user\'] = normalize_id_series(df[\'user\'])\n    df[\'item\'] = normalize_id_series(df[\'item\'])\n    df[\'rating\'] = 1.0\n    return df[[\'user\', \'item\', \'rating\']]\n\n\ndef core_filter(df, min_uc=5, min_ic=5):\n    while True:\n        ucnt = df.groupby(\'user\').size()\n        keep_u = ucnt[ucnt >= min_uc].index\n        df2 = df[df[\'user\'].isin(keep_u)]\n        icnt = df2.groupby(\'item\').size()\n        keep_i = icnt[icnt >= min_ic].index\n        df2 = df2[df2[\'item\'].isin(keep_i)]\n        if len(df2) == len(df):\n            return df2.reset_index(drop=True)\n        df = df2\n\n\ndef make_split(df, seed):\n    tr_rows, te_rows = [], []\n    for _, grp in df.groupby(\'user\'):\n        if len(grp) < 2:\n            continue\n        tr_idx, te_idx = train_test_split(grp.index.to_numpy(), test_size=0.2, random_state=seed)\n        tr_rows.append(df.loc[tr_idx])\n        te_rows.append(df.loc[te_idx])\n    train = pd.concat(tr_rows, ignore_index=True)\n    test = pd.concat(te_rows, ignore_index=True)\n    return train, test\n\n\ndef map_to_consecutive_ids(train, test):\n    all_users = pd.Index(pd.concat([train[\'user\'], test[\'user\']], ignore_index=True).unique())\n    all_items = pd.Index(pd.concat([train[\'item\'], test[\'item\']], ignore_index=True).unique())\n    umap = {u: i for i, u in enumerate(all_users)}\n    imap = {i: j for j, i in enumerate(all_items)}\n    tr = train.copy()\n    te = test.copy()\n    tr[\'user\'] = tr[\'user\'].map(umap).astype(\'int64\')\n    tr[\'item\'] = tr[\'item\'].map(imap).astype(\'int64\')\n    te[\'user\'] = te[\'user\'].map(umap).astype(\'int64\')\n    te[\'item\'] = te[\'item\'].map(imap).astype(\'int64\')\n    return tr, te\n\n\ndef precision_ndcg_at_k(recs, truth, k):\n    truth = set(truth)\n    if not truth:\n        return np.nan, np.nan\n    recs = list(recs)[:k]\n    hits = [1 if i in truth else 0 for i in recs]\n    prec = sum(hits) / float(k)\n    dcg = sum(h / math.log2(idx + 2) for idx, h in enumerate(hits))\n    ideal = sum(1.0 / math.log2(idx + 2) for idx in range(min(len(truth), k)))\n    ndcg = dcg / ideal if ideal > 0 else np.nan\n    return prec, ndcg\n\n\ndef eval_ranking(model, train, test, k_list=(1, 5, 10)):\n    users = test[\'user\'].unique()\n    truth = test.groupby(\'user\')[\'item\'].apply(list).to_dict()\n    recs = batch.recommend(model, users, n=max(k_list), ratings=train)\n    rows = []\n    for u in users:\n        items = recs[recs[\'user\'] == u][\'item\'].tolist()\n        row = {\'user\': u}\n        for k in k_list:\n            p, n = precision_ndcg_at_k(items, truth.get(u, []), k)\n            row[f\'precision@{k}\'] = p\n            row[f\'ndcg@{k}\'] = n\n        rows.append(row)\n    return pd.DataFrame(rows)\n\n\ndef build_model(name):\n    if name == \'ALS\':\n        return BiasedMF(50, reg=0.1, iterations=10, method=\'als\')\n    if name == \'ItemKNN\':\n        return ItemItem(nnbrs=20, min_nbrs=1)\n    if name == \'Pop\':\n        return Popular()\n    raise ValueError(name)\n\n\nall_summary = []\n\nfor dname, path in DATA_FILES.items():\n    if dname == \'MovieLens100K\':\n        df = load_movielens(path)\n    elif dname == \'AmazonVideoGames\':\n        df = load_amazon(path)\n    else:\n        df = load_lastfm(path)\n    df = core_filter(df, 5, 5)\n    print(f\'{dname}: {len(df)} interactions after 5-core filtering\')\n    for seed in SEEDS:\n        train, test = make_split(df, seed)\n        train, test = map_to_consecutive_ids(train, test)\n        for alg in ALGS:\n            model = build_model(alg)\n            t0 = time.time()\n            model.fit(train)\n            fit_time = time.time() - t0\n            metrics_df = eval_ranking(model, train, test, KS)\n            row = {\'dataset\': dname, \'seed\': seed, \'algorithm\': alg, \'fit_time\': fit_time}\n            for k in KS:\n                row[f\'precision@{k}\'] = float(metrics_df[f\'precision@{k}\'].mean())\n                row[f\'ndcg@{k}\'] = float(metrics_df[f\'ndcg@{k}\'].mean())\n            all_summary.append(row)\n            experiment_data[dname][\'results\'].append(row)\n            experiment_data[dname][\'metrics\'][\'val\'].append({**{\'seed\': seed, \'algorithm\': alg}, **{f\'precision@{k}\': row[f\'precision@{k}\'] for k in KS}, **{f\'ndcg@{k}\': row[f\'ndcg@{k}\'] for k in KS}})\n            experiment_data[dname][\'predictions\'].append(metrics_df.to_numpy())\n            experiment_data[dname][\'ground_truth\'].append(test.to_numpy())\n            print(f"{dname} | seed={seed} | {alg} | " + ", ".join([f\'P@{k}={row[f"precision@{k}"]:.4f}, nDCG@{k}={row[f"ndcg@{k}"]:.4f}\' for k in KS]))\n\nsummary = pd.DataFrame(all_summary)\nsummary.to_csv(os.path.join(working_dir, \'summary_results.csv\'), index=False)\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\nnp.save(os.path.join(working_dir, \'summary_array.npy\'), summary.to_numpy(dtype=object))\n\nprint(\'\\nAggregated results (mean ± std over 5 seeds):\')\nfor (d, a), grp in summary.groupby([\'dataset\', \'algorithm\']):\n    print(f\'\\n{d} / {a}\')\n    for k in KS:\n        p = grp[f\'precision@{k}\']\n        n = grp[f\'ndcg@{k}\']\n        print(f\'  P@{k}: {p.mean():.4f} ± {p.std(ddof=1):.4f} | nDCG@{k}: {n.mean():.4f} ± {n.std(ddof=1):.4f}\')\n\nprint(\'\\nShort statistical analysis (paired t-tests over seeds, metric=nDCG@10):\')\nfor d in summary[\'dataset\'].unique():\n    sub = summary[summary[\'dataset\'] == d]\n    pivot = sub.pivot(index=\'seed\', columns=\'algorithm\', values=\'ndcg@10\')\n    for a1, a2 in [(\'ALS\', \'ItemKNN\'), (\'ALS\', \'Pop\'), (\'ItemKNN\', \'Pop\')]:\n        x = pivot[a1].dropna().values\n        y = pivot[a2].dropna().values\n        if len(x) == len(y) and len(x) > 1:\n            t, p = stats.ttest_rel(x, y)\n            print(f\'{d}: {a1} vs {a2} -> t={t:.3f}, p={p:.4f}, mean_diff={(x - y).mean():.4f}\')\n\ntry:\n    import matplotlib.pyplot as plt\n    for d in summary[\'dataset\'].unique():\n        fig, ax = plt.subplots(figsize=(8, 4))\n        sub = summary[summary[\'dataset\'] == d]\n        for alg in ALGS:\n            vals = sub[sub[\'algorithm\'] == alg].sort_values(\'seed\')[\'ndcg@10\'].values\n            ax.plot(SEEDS[:len(vals)], vals, marker=\'o\', label=alg)\n        ax.set_title(f\'{d} - nDCG@10 across seeds\')\n        ax.set_xlabel(\'Seed\')\n        ax.set_ylabel(\'nDCG@10\')\n        ax.legend()\n        fig.tight_layout()\n        fig.savefig(os.path.join(working_dir, f\'{d}_seed_variability_ndcg10.png\'), dpi=150)\n        plt.close(fig)\nexcept Exception as e:\n    print(f\'Plotting skipped: {e}\')\n\nprint(\'\\nDone. Files saved to:\', working_dir)\n\n```', 'Execution Output': '```\nMovieLens100K: 54413 interactions after 5-core filtering\nNumba is using threading layer omp - consider TBB\nfound 1 potential runtime problems - see https://boi.st/lkpy-perf\nTraceback (most recent call last):\n  File "C:\\Users\\lukas\\AutoRecLab_Team7\\treesearch\\interpreter.py", line 147, in _run_session\n    exec(compile(code, self.agent_file_name, "exec"), global_scope)\n  File "runfile.py", line 174, in <module>\n  File "C:\\Users\\lukas\\AutoRecLab_Team7\\.venv\\Lib\\site-packages\\lenskit\\algorithms\\als.py", line 376, in fit\n    for epoch, algo in enumerate(self.fit_iters(ratings, **kwargs)):\n  File "C:\\Users\\lukas\\AutoRecLab_Team7\\.venv\\Lib\\site-packages\\lenskit\\algorithms\\als.py", line 409, in fit_iters\n    for epoch, model in enumerate(self._train_iters(current, uctx, ictx)):\n  File "C:\\Users\\lukas\\AutoRecLab_Team7\\.venv\\Lib\\site-packages\\lenskit\\algorithms\\als.py", line 469, in _train_iters\n    raise ValueError(\'invalid training