ics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': [], \'splits\': []},\\n    \'amazon_vg\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': [], \'splits\': []},\\n    \'lastfm\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': [], \'splits\': []},\\n}\\n\\n\\ndef _canon_ids(df):\\n    df = df.copy()\\n    df[\'user\'] = df[\'user\'].astype(str)\\n    df[\'item\'] = df[\'item\'].astype(str)\\n    if \'timestamp\' not in df.columns:\\n        df[\'timestamp\'] = np.arange(len(df), dtype=np.int64)\\n    df[\'rating\'] = 1.0\\n    return df[[\'user\', \'item\', \'rating\', \'timestamp\']].drop_duplicates([\'user\', \'item\']).reset_index(drop=True)\\n\\n\\ndef load_movielens(path=\'u.data\'):\\n    df = pd.read_csv(path, sep=\'\\\\t\', names=[\'user\', \'item\', \'rating\', \'timestamp\'])\\n    df = df[df[\'rating\'] > 3].copy()\\n    return _canon_ids(df)\\n\\n\\ndef load_amazon(path=\'VideoGames.csv\'):\\n    df = pd.read_csv(path)\\n    cols = {c.lower(): c for c in df.columns}\\n    user_col = cols.get(\'reviewerid\') or cols.get(\'user_id\') or cols.get(\'user\')\\n    item_col = cols.get(\'asin\') or cols.get(\'item_id\') or cols.get(\'item\')\\n    rating_col = cols.get(\'overall\') or cols.get(\'rating\')\\n    time_col = cols.get(\'unixreviewtime\') or cols.get(\'timestamp\')\\n    if user_col is None or item_col is None or rating_col is None:\\n        raise ValueError(\'Could not identify Amazon columns\')\\n    keep = [user_col, item_col, rating_col] + ([time_col] if time_col is not None else [])\\n    df = df[keep].copy()\\n    df = df[df[rating_col] > 3].copy()\\n    out = pd.DataFrame({\'user\': df[user_col], \'item\': df[item_col]})\\n    out[\'timestamp\'] = df[time_col] if time_col is not None else np.arange(len(out), dtype=np.int64)\\n    return _canon_ids(out)\\n\\n\\ndef load_lastfm(path=\'user_taggedartists-timestamps.dat\'):\\n    # Last.FM file can be tab-separated with headers, but handle generic parsing safely.\\n    df = pd.read_csv(path, sep=\'\\\\t\', low_memory=False)\\n    cols = {c.lower(): c for c in df.columns}\\n    user_col = cols.get(\'userid\') or cols.get(\'user_id\') or cols.get(\'user\')\\n    item_col = cols.get(\'artistid\') or cols.get(\'artist_id\') or cols.get(\'item\')\\n    time_col = cols.get(\'timestamp\') or cols.get(\'time\')\\n    if user_col is None or item_col is None:\\n        raise ValueError(\'Could not identify LastFM columns\')\\n    out = pd.DataFrame({\'user\': df[user_col], \'item\': df[item_col]})\\n    out[\'timestamp\'] = df[time_col] if time_col is not None else np.arange(len(out), dtype=np.int64)\\n    return _canon_ids(out)\\n\\n\\ndef core_filter(df, min_uc=5, min_ic=5):\\n    df = df.copy()\\n    changed = True\\n    while changed:\\n        changed = False\\n        ucnt = df.groupby(\'user\').size()\\n        keep_u = ucnt[ucnt >= min_uc].index\\n        new_df = df[df[\'user\'].isin(keep_u)]\\n        if len(new_df) != len(df):\\n            changed = True\\n        df = new_df\\n        icnt = df.groupby(\'item\').size()\\n        keep_i = icnt[icnt >= min_ic].index\\n        new_df = df[df[\'item\'].isin(keep_i)]\\n        if len(new_df) != len(df):\\n            changed = True\\n        df = new_df\\n    return df.reset_index(drop=True)\\n\\n\\ndef split_user_holdout(df, seed, test_frac=0.2):\\n    rng = np.random.default_rng(seed)\\n    train_parts, test_parts = [], []\\n    for _, grp in df.groupby(\'user\', sort=False):\\n        idx = grp.index.to_numpy()\\n        perm = rng.permutation(idx)\\n        n_test = int(np.floor(len(idx) * test_frac))\\n        n_test = max(1, min(n_test, len(idx) - 1))\\n        test_idx = perm[:n_test]\\n        train_idx = perm[n_test:]\\n        train_parts.append(df.loc[train_idx])\\n        test_parts.append(df.loc[test_idx])\\n    train = pd.concat(train_parts, ignore_index=True)\\n    test = pd.concat(test_parts, ignore_index=True)\\n    return train, test\\n\\n\\ndef build_model(name, seed):\\n    if name == \'ALS\':\\n        return ImplicitMF(features=50, iterations=10, reg=0.1, random_state=seed)\\n    if name == \'ItemKNN\':\\n        return ItemItem(nnbrs=100, min_nbrs=1)\\n    if name == \'Pop\':\\n        return Popular()\\n    raise ValueError(name)\\n\\n\\ndef rec_frame_to_user_lists(recs):\\n    # Support common LensKit output variants.\\n    if recs is None or len(recs) == 0:\\n        return {}\\n    df = recs.copy()\\n    if \'user\' not in df.columns:\\n        raise ValueError(\'Recommendation output missing user column\')\\n    item_col = \'item\' if \'item\' in df.columns else \'item_id\'\\n    out = {}\\n    for u, grp in df.groupby(\'user\'):\\n        out[str(u)] = grp[item_col].astype(str).tolist()\\n    return out\\n\\n\\ndef compute_metrics(rec_lists, truth, k):\\n    if precision is None or ndcg is None:\\n        return np.nan, np.nan\\n    try:\\n        p = precision(rec_lists, truth, k)\\n        n = ndcg(rec_lists, truth, k)\\n        return float(p), float(n)\\n    except Exception:\\n        # Fallback manual computation if LensKit metric API differs.\\n        vals_p, vals_n = [], []\\n        for u, rel_items in truth.items():\\n            recs = rec_lists.get(u, [])[:k]\\n            if len(rel_items) == 0:\\n                continue\\n            hits = [1 if i in set(rel_items) else 0 for i in recs]\\n            vals_p.append(sum(hits) / k)\\n            dcg = sum(rel / np.log2(idx + 2) for idx, rel in enumerate(hits))\\n            ideal = min(len(rel_items), k)\\n            idcg = sum(1.0 / np.log2(i + 2) for i in range(ideal))\\n            vals_n.append(dcg / idcg if idcg > 0 else 0.0)\\n        return (float(np.mean(vals_p)) if vals_p else np.nan, float(np.mean(vals_n)) if vals_n else np.nan)\\n\\n\\ndef evaluate(model, train, test, k_values=(1, 5, 10)):\\n    truth = test.groupby(\'user\')[\'item\'].apply(lambda s: list(map(str, s.tolist()))).to_dict()\\n    users = np.array(list(truth.keys()), dtype=object)\\n    recs = batch.recommend(model, users, n=max(k_values))\\n    rec_lists = rec_frame_to_user_lists(recs)\\n    out = {}\\n    for k in k_values:\\n        p, n = compute_metrics(rec_lists, truth, k)\\n        out[f\'Precision@{k}\'] = p\\n        out[f\'nDCG@{k}\'] = n\\n    return out, recs, truth\\n\\n\\ndef load_dataset(name):\\n    if name == \'ml100k\':\\n        return load_movielens(\'u.data\')\\n    if name == \'amazon_vg\':\\n        return load_amazon(\'VideoGames.csv\')\\n    if name == \'lastfm\':\\n        return load_lastfm(\'user_taggedartists-timestamps.dat\')\\n    raise ValueError(name)\\n\\n\\ndatasets = [\'ml100k\', \'amazon_vg\', \'lastfm\']\\nalgorithms = [\'ALS\', \'ItemKNN\', \'Pop\']\\nseeds = [11, 22, 33, 44, 55]\\nk_values = [1, 5, 10]\\nall_results = []\\nstart_time = time.time()\\n\\nfor dname in datasets:\\n    df = load_dataset(dname)\\n    df = core_filter(df, 5, 5)\\n    df = _canon_ids(df)\\n    np.save(os.path.join(working_dir, f\'{dname}_preprocessed.npy\'), df.to_records(index=False))\\n    for seed in seeds:\\n        train, test = split_user_holdout(df, seed, 0.2)\\n        experiment_data[dname][\'splits\'].append({\'seed\': seed, \'train_n\': len(train), \'test_n\': len(test)})\\n        for alg in algorithms:\\n            model = build_model(alg, seed)\\n            model.fit(train[[\'user\', \'item\', \'rating\']])\\n            metrics, recs, truth = evaluate(model, train, test, k_values)\\n            row = {\'dataset\': dname, \'seed\': seed, \'algorithm\': alg}\\n            row.update(metrics)\\n            all_results.append(row)\\n            experiment_data[dname][\'metrics\'][\'val\'].append([seed, alg] + [metrics[f\'Precision@{k}\'] for k in k_values] + [metrics[f\'nDCG@{k}\'] for k in k_values])\\n            e