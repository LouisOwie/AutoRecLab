l is None or item_col is None or rating_col is None:\n        raise ValueError(\'Could not identify Amazon columns\')\n    keep = [user_col, item_col, rating_col] + ([time_col] if time_col is not None else [])\n    df = df[keep].copy()\n    df = df[df[rating_col] > 3].copy()\n    out = pd.DataFrame({\'user\': df[user_col], \'item\': df[item_col]})\n    out[\'timestamp\'] = df[time_col] if time_col is not None else np.arange(len(out), dtype=np.int64)\n    return _canon_ids(out)\n\n\ndef load_lastfm(path=\'user_taggedartists-timestamps.dat\'):\n    # Last.FM file can be tab-separated with headers, but handle generic parsing safely.\n    df = pd.read_csv(path, sep=\'\\t\', low_memory=False)\n    cols = {c.lower(): c for c in df.columns}\n    user_col = cols.get(\'userid\') or cols.get(\'user_id\') or cols.get(\'user\')\n    item_col = cols.get(\'artistid\') or cols.get(\'artist_id\') or cols.get(\'item\')\n    time_col = cols.get(\'timestamp\') or cols.get(\'time\')\n    if user_col is None or item_col is None:\n        raise ValueError(\'Could not identify LastFM columns\')\n    out = pd.DataFrame({\'user\': df[user_col], \'item\': df[item_col]})\n    out[\'timestamp\'] = df[time_col] if time_col is not None else np.arange(len(out), dtype=np.int64)\n    return _canon_ids(out)\n\n\ndef core_filter(df, min_uc=5, min_ic=5):\n    df = df.copy()\n    changed = True\n    while changed:\n        changed = False\n        ucnt = df.groupby(\'user\').size()\n        keep_u = ucnt[ucnt >= min_uc].index\n        new_df = df[df[\'user\'].isin(keep_u)]\n        if len(new_df) != len(df):\n            changed = True\n        df = new_df\n        icnt = df.groupby(\'item\').size()\n        keep_i = icnt[icnt >= min_ic].index\n        new_df = df[df[\'item\'].isin(keep_i)]\n        if len(new_df) != len(df):\n            changed = True\n        df = new_df\n    return df.reset_index(drop=True)\n\n\ndef split_user_holdout(df, seed, test_frac=0.2):\n    rng = np.random.default_rng(seed)