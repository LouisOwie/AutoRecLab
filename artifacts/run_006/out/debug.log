 None:\n        raise ValueError(\'Could not infer Amazon Video Games columns.\')\n    keep = [user_col, item_col, rating_col] + ([time_col] if time_col is not None else [])\n    df = df[keep].copy()\n    df = df[df[rating_col] > 3].copy()\n    rename = {user_col: \'user\', item_col: \'item\'}\n    if time_col is not None:\n        rename[time_col] = \'timestamp\'\n    df = df.rename(columns=rename)\n    if \'timestamp\' not in df.columns:\n        df[\'timestamp\'] = np.arange(len(df), dtype=np.int64)\n    return df[[\'user\', \'item\', \'timestamp\']]\n\n\ndef load_lastfm(path):\n    df = _read_flexible_table(path)\n    cols = {c.lower(): c for c in df.columns}\n    user_col = cols.get(\'userid\', cols.get(\'user_id\', df.columns[0]))\n    item_col = cols.get(\'artistid\', cols.get(\'item_id\', df.columns[1]))\n    time_col = cols.get(\'timestamp\', df.columns[-1])\n    df = df[[user_col, item_col, time_col]].copy()\n    df = df.rename(columns={user_col: \'user\', item_col: \'item\', time_col: \'timestamp\'})\n    return df\n\n\ndef core_filter(df, min_core=5):\n    df = df.copy()\n    changed = True\n    while changed:\n        changed = False\n        ucnt = df[\'user\'].value_counts()\n        icnt = df[\'item\'].value_counts()\n        keep = df[\'user\'].isin(ucnt[ucnt >= min_core].index) & df[\'item\'].isin(icnt[icnt >= min_core].index)\n        new_df = df.loc[keep].copy()\n        if len(new_df) != len(df):\n            df = new_df\n            changed = True\n    return df\n\n# -----------------------------\n# Helpers\n# -----------------------------\ndef make_algo(name):\n    if name == \'ALS\':\n        return BiasedMF(features=50, iterations=15, reg=0.1, damping=0.0, random_state=42)\n    if name == \'ItemKNN\':\n        return ItemItem(nnbrs=100, min_nbrs=1, center=False, aggregate=\'sum\')\n    if name == \'Pop\':\n        return Popular()\n    raise ValueError(name)\n\n\ndef _ensure_user_item_cols(df):\n    return df[[\'user\', \'item\']].copy()\n\n\ndef eval_one(train, test, algo, k_list=K_LIST, top_n=TOP_N):\n    train_ui = _ensure_user_item_cols(train)\n    test_ui = _ensure_user_item_cols(test)\n    model = algo.fit(train_ui)\n    users = test_ui[\'user\'].unique()\n    recs = batch.recommend(model, users, n=top_n)\n    if recs is None or len(recs) == 0:\n        return {f\'precision@{k}\': np.nan for k in k_list} | {f\'ndcg@{k}\': np.nan for k in k_list}\n    out = {}\n    for k in k_list:\n        try:\n            out[f\'precision@{k}\'] = float(topn.precision(recs, test_ui, k=k))\n        except Exception:\n            out[f\'precision@{k}\'] = np.nan\n        try:\n            out[f\'ndcg@{k}\'] = float(topn.ndcg(recs, test_ui, k=k))\n        except Exception:\n            out[f\'ndcg@{k}\'] = np.nan\n    return out\n\n\ndef run_experiment(name, df):\n    rows = []\n    for seed in SEEDS:\n        splitter = crossfold.SampleFrac(0.2, seed=seed, disjoint=False)\n        for fold_idx, (train, test) in enumerate(splitter.split(df)):\n            train = train[[\'user\', \'item\']].copy()\n            test = test[[\'user\', \'item\']].copy()\n            for algo_name in ALGORITHMS:\n                algo = make_algo(algo_name)\n                metrics = eval_one(train, test, algo, K_LIST, TOP_N)\n                row = {\'dataset\': name, \'seed\': seed, \'fold\': fold_idx, \'algo\': algo_name}\n                row.update(metrics)\n                rows.append(row)\n                experiment_data[name][\'runs\'].append(row)\n                print(f"{name} | seed={seed} | {algo_name} | " + ", ".join([f"{k}={v:.4f}" if pd.notna(v) else f"{k}=nan" for k, v in metrics.items()]))\n    return pd.DataFrame(rows)\n\n\ndef save_np(path, obj):\n    np.save(path, np.array([obj], dtype=object), allow_pickle=True)\n\n# -----------------------------\n# Main experiment\n# -----------------------------\npaths = {\n    \'MovieLens100K\': os.path.join(os.getcwd(), \'u.data\'),\n    \'AmazonVideoGames\': os.path.join(os.getcwd(), \'VideoGames.csv\'),\n    \'LastFM\': os.path.join(os.getcwd(), \'user_taggedartists-timestamps.dat\'),\n}\nloaders = {\n    \'MovieLens100K\': load_movielens,\n    \'AmazonVideoGames\': load_amazon_vg,\n    \'LastFM\': load_lastfm,\n}\n\nall_results = []\nfor ds_name in [\'MovieLens100K\', \'AmazonVideoGames\', \'LastFM\']:\n    print(f\'\\n=== Loading {ds_name} ===\')\n    df = loaders[ds_name](paths[ds_name])\n    df = core_filter(df, MIN_CORE)\n    df = df.dropna().drop_duplicates(subset=[\'user\', \'item\']).copy()\n    df[\'user\'] = df[\'user\'].astype(str)\n    df[\'item\'] = df[\'item\'].astype(str)\n    if \'timestamp\' in df.columns:\n        df[\'timestamp\'] = pd.to_numeric(df[\'timestamp\'], errors=\'coerce\').fillna(0).astype(np.int64)\n    print(f\'{ds_name}: {len(df):,} interactions, {df.user.nunique():,} users, {df.item.nunique():,} items after 5-core.\')\n    res = run_experiment(ds_name, df)\n    all_results.append(res)\n\nresults = pd.concat(all_results, ignore_index=True)\nresults.to_csv(os.path.join(working_dir, \'all_results.csv\'), index=False)\n\n# Save experiment data and arrays\nfor ds in results[\'dataset\'].unique():\n    sub = results[results[\'dataset\'] == ds]\n    experiment_data[ds][\'metrics\'][\'val\'] = sub.to_dict(\'records\')\n    experiment_data[ds][\'predictions\'] = []\n    experiment_data[ds][\'ground_truth\'] = []\n\nsave_np(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\nsave_np(os.path.join(working_dir, \'results_array.npy\'), results.to_records(index=False))\n\n# Summary tables\nmetric_cols = [c for c in results.columns if \'@\' in c]\nprint(\'\\n=== Mean metrics across seeds ===\')\nfor ds in results[\'dataset\'].unique():\n    print(f\'\\nDataset: {ds}\')\n    sub = results[results[\'dataset\'] == ds]\n    for algo in ALGORITHMS:\n        s = sub[sub[\'algo\'] == algo]\n        vals = s[metric_cols].mean(numeric_only=True)\n        print(algo + \': \' + \', \'.join([f\'{c}={vals[c]:.4f}\' for c in metric_cols]))\n\nprint(\'\\n=== Short statistical analysis (paired Wilcoxon on seed-averaged runs) ===\')\nfor ds in results[\'dataset\'].unique():\n    sub = results[results[\'dataset\'] == ds]\n    for metric in [\'ndcg@10\', \'precision@10\']:\n        pivot = sub.groupby([\'seed\', \'algo\'])[metric].mean().unstack(\'algo\')\n        for a, b in [(\'ALS\', \'ItemKNN\'), (\'ALS\', \'Pop\'), (\'ItemKNN\', \'Pop\')]:\n            if a in pivot.columns and b in pivot.columns:\n                common = pivot[[a, b]].dropna()\n                if len(common) >= 3:\n                    try:\n                        stat, p = stats.wilcoxon(common[a], common[b], zero_method=\'wilcox\', alternative=\'two-sided\')\n                        diff = (common[a] - common[b]).mean()\n                        print(f\'{ds} | {metric} | {a} vs {b}: mean_diff={diff:.4f}, wilcoxon_p={p:.4g}, n={len(common)}\')\n                    except Exception as e:\n                        print(f\'{ds} | {metric} | {a} vs {b}: statistical test failed ({e})\')\n\n# Optional plotting only if matplotlib is available\nif HAVE_PLT:\n    for ds in results[\'dataset\'].unique():\n        sub = results[results[\'dataset\'] == ds]\n        fig, axes = plt.subplots(1, 2, figsize=(10, 4), constrained_layout=True)\n        for ax, metric in zip(axes, [\'precision@10\', \'ndcg@10\']):\n            grp = sub.groupby(\'algo\')[metric].agg([\'mean\', \'std\']).reindex(ALGORITHMS)\n            ax.bar(grp.index, grp[\'mean\'], yerr=grp[\'std\'].fillna(0), capsize=4)\n            ax.set_title(f\'{ds} - {metric}\')\n            ax.set_ylim(bottom=0)\n            ax.grid(axis=\'y\', alpha=0.3)\n        fig.savefig(os.path.join(working_dir, f\'{ds}_metric_comparison.png\'), dpi=160)\n        plt.close(fig)\n\nprint(\'\\nSaved results to working directory:\', working_dir)\nprint(\'Done.\')\n```', 'Execution Output': '```\n\n=== Loading MovieLens100K ===\nMovieLens100K: 54,413 interactions, 938 users, 1,008 i