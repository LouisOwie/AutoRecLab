iewerid\', lower.get(\'user_id\', lower.get(\'user\')))\n    item_col = lower.get(\'asin\', lower.get(\'item_id\', lower.get(\'item\')))\n    rating_col = lower.get(\'overall\', lower.get(\'rating\'))\n    time_col = lower.get(\'unixreviewtime\', lower.get(\'timestamp\'))\n    if user_col is None or item_col is None or rating_col is None:\n        raise ValueError(\'Could not infer Amazon Video Games columns.\')\n    keep = [user_col, item_col, rating_col] + ([time_col] if time_col else [])\n    df = df[keep].copy()\n    df = df[df[rating_col] > 3].copy()\n    df = df.rename(columns={user_col: \'user\', item_col: \'item\'})\n    if time_col:\n        df = df.rename(columns={time_col: \'timestamp\'})\n    else:\n        df[\'timestamp\'] = np.arange(len(df))\n    return df[[\'user\', \'item\', \'timestamp\']]\n\n\ndef load_lastfm(path):\n    df = pd.read_csv(path, sep=\'\\t\', engine=\'python\')\n    cols = {c.lower(): c for c in df.columns}\n    user_col = cols.get(\'userid\', list(df.columns)[0])\n    item_col = cols.get(\'artistid\', list(df.columns)[1])\n    time_col = cols.get(\'timestamp\', list(df.columns)[-1])\n    df = df[[user_col, item_col, time_col]].copy()\n    df = df.rename(columns={user_col: \'user\', item_col: \'item\', time_col: \'timestamp\'})\n    return df\n\n\ndef core_filter(df, min_core=5):\n    df = df.copy()\n    changed = True\n    while changed:\n        changed = False\n        ucnt = df[\'user\'].value_counts()\n        icnt = df[\'item\'].value_counts()\n        keep = df[\'user\'].isin(ucnt[ucnt >= min_core].index) & df[\'item\'].isin(icnt[icnt >= min_core].index)\n        new_df = df[keep].copy()\n        if len(new_df) != len(df):\n            df = new_df\n            changed = True\n    return df\n\n# -----------------------------\n# Metric helpers\n# -----------------------------\ndef _dcg(relevant_ranks):\n    return sum((1.0 / np.log2(r + 1)) for r in relevant_ranks)\n\n\ndef user_metrics(rec_df, test_df, k):\n    if rec_df is None or len(rec_df) == 0 or test_df is None or len(test_df) == 0:\n        return np.nan, np.nan\n    rec_df = rec_df[[\'user\', \'item\']].copy()\n    test_df = test_df[[\'user\', \'item\']].copy()\n    p_list, n_list = [], []\n    test_by_user = test_df.groupby(\'user\')[\'item\'].apply(set).to_dict()\n    rec_by_user = rec_df.groupby(\'user\')[\'item\'].apply(list).to_dict()\n    for u, truth in test_by_user.items():\n        recs = rec_by_user.get(u, [])[:k]\n        if len(recs) == 0:\n            p_list.append(0.0)\n            n_list.append(0.0)\n            continue\n        hits = [i for i, it in enumerate(recs, start=1) if it in truth]\n        p_list.append(len(hits) / float(k))\n        dcg = _dcg(hits)\n        idcg = _dcg(range(1, min(len(truth), k) + 1))\n        n_list.append(dcg / idcg if idcg > 0 else 0.0)\n    return float(np.mean(p_list)), float(np.mean(n_list))\n\n\ndef eval_one(train, test, algo, k_list=(1, 5, 10), top_n=50):\n    model = algo.fit(train)\n    users = test[\'user\'].unique()\n    recs = batch.recommend(model, users, n=top_n)\n    out = {}\n    for k in k_list:\n        p, n = user_metrics(recs, test, k)\n        out[f\'precision@{k}\'] = p\n        out[f\'ndcg@{k}\'] = n\n    return out, recs\n\n\ndef make_algo(name):\n    if name == \'ALS\':\n        return BiasedMF(features=50, iterations=15, reg=0.1, damping=0.0, random_state=42)\n    if name == \'ItemKNN\':\n        return ItemItem(nnbrs=100, min_nbrs=1, center=False, aggregate=\'sum\')\n    if name == \'Pop\':\n        return Popular()\n    raise ValueError(name)\n\n\ndef holdout_split(df, seed):\n    # User-based 80/20 holdout split in LensKit crossfold\n    splitter = xf.SampleFrac(0.2, seed=seed, disjoint=True)\n    folds = list(splitter.split(df))\n    if len(folds) == 0:\n        raise ValueError(\'No split produced.\')\n    # Use the first and only holdout-style split\n    train, test = folds[0]\n    return train.copy(), test.copy()\n\n\ndef run_experiment(name, df):\n    rows = []\n    for seed in SEEDS:\n        train, test = holdout_split(df, seed)\n        for algo_name in ALGO_NAMES:\n            algo = make_algo(algo_name)\n            metrics, recs = eval_one(train, test, algo, K_LIST, TOP_N)\n            row = {\'dataset\': name, \'seed\': seed, \'algo\': algo_name}\n            row.update(metrics)\n            rows.append(row)\n            experiment_data[name][\'runs\'].append(row)\n            experiment_data[name][\'predictions\'].append(recs.assign(dataset=name, seed=seed, algo=algo_name))\n            experiment_data[name][\'ground_truth\'].append(test.assign(dataset=name, seed=seed))\n            print(f"{name} | seed={seed} | {algo_name} | " + ", ".join([f"{k}={v:.4f}" for k, v in metrics.items()]))\n    return pd.DataFrame(rows)\n\n# -----------------------------\n# Main\n# -----------------------------\npaths = {\n    \'MovieLens100K\': os.path.join(os.getcwd(), \'u.data\'),\n    \'AmazonVideoGames\': os.path.join(os.getcwd(), \'VideoGames.csv\'),\n    \'LastFM\': os.path.join(os.getcwd(), \'user_taggedartists-timestamps.dat\'),\n}\nloaders = {\n    \'MovieLens100K\': load_movielens,\n    \'AmazonVideoGames\': load_amazon_vg,\n    \'LastFM\': load_lastfm,\n}\n\nall_results = []\nfor ds_name in [\'MovieLens100K\', \'AmazonVideoGames\', \'LastFM\']:\n    print(f\'\\n=== Loading {ds_name} ===\')\n    df = loaders[ds_name](paths[ds_name])\n    df = core_filter(df, MIN_CORE)\n    df = df.dropna().drop_duplicates(subset=[\'user\', \'item\'])\n    df[\'user\'] = df[\'user\'].astype(str)\n    df[\'item\'] = df[\'item\'].astype(str)\n    if \'timestamp\' in df.columns:\n        df = df.sort_values([\'user\', \'timestamp\'])\n    else:\n        df = df.sort_values([\'user\', \'item\'])\n    print(f\'{ds_name}: {len(df):,} interactions, {df.user.nunique():,} users, {df.item.nunique():,} items after 5-core.\')\n    res = run_experiment(ds_name, df)\n    all_results.append(res)\n\nresults = pd.concat(all_results, ignore_index=True)\nresults.to_csv(os.path.join(working_dir, \'all_results.csv\'), index=False)\n\n# Save all plottable arrays\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\nnp.save(os.path.join(working_dir, \'results_array.npy\'), results.to_records(index=False))\n\n# Summary\nmetric_cols = [c for c in results.columns if \'@\' in c]\nprint(\'\\n=== Mean metrics across seeds ===\')\nfor ds in results[\'dataset\'].unique():\n    print(f\'\\nDataset: {ds}\')\n    sub = results[results[\'dataset\'] == ds]\n    for algo in ALGO_NAMES:\n        s = sub[sub[\'algo\'] == algo]\n        vals = s[metric_cols].mean()\n        print(algo + \': \' + \', \'.join([f\'{c}={vals[c]:.4f}\' for c in metric_cols]))\n\nprint(\'\\n=== Short statistical analysis (paired Wilcoxon on seed-level results) ===\')\nfor ds in results[\'dataset\'].unique():\n    sub = results[results[\'dataset\'] == ds]\n    for metric in [\'ndcg@10\', \'precision@10\']:\n        pivot = sub.groupby([\'seed\', \'algo\'])[metric].mean().unstack(\'algo\')\n        for a, b in [(\'ALS\', \'ItemKNN\'), (\'ALS\', \'Pop\'), (\'ItemKNN\', \'Pop\')]:\n            if a in pivot.columns and b in pivot.columns:\n                common = pivot[[a, b]].dropna()\n                if len(common) >= 3:\n                    stat, p = stats.wilcoxon(common[a], common[b], zero_method=\'wilcox\', alternative=\'two-sided\')\n                    diff = (common[a] - common[b]).mean()\n                    print(f\'{ds} | {metric} | {a} vs {b}: mean_diff={diff:.4f}, wilcoxon_p={p:.4g}, n={len(common)}\')\n\n# Optional visualization\nif HAVE_MPL:\n    for metric in [\'precision@10\', \'ndcg@10\']:\n        fig, axes = plt.subplots(3, 1, figsize=(10, 12), constrained_layout=True)\n        for i, ds in enumerate(results[\'dataset\'].unique()):\n            ax = axes[i]\n            sub = results[results[\'dataset\'] == ds]\n            grp = sub.groupby(\'algo\')[metric].agg([\'mean\', \'std\']).reindex(ALGO_NAMES)\n            ax.bar(grp.index, grp[\'mean\'], yerr=grp[\'std\'].fillna(0), capsize=4)\n            ax.set_title(f\'{ds} - {metric}\')\n            ax.set_ylim(bottom=0)\n            ax.grid(axis=\'y\', alpha=0.3)\n        fig.savefig(os.path.join(working_dir, f\'metric_comparison_{metric.replace("@", "at")}.png\'), dpi=160)\n        plt.close(fig)\nelse:\n    print(\'matplotlib not available; skipping plots.\')\n\nprint(\'\\nSaved results to working directory:\', working_dir)\nprint(\'Done.\')\n```', 'Execution Output': '```\n\n=== Loading MovieLens100K ===\nMovieLens100K: 54,413 interactions, 938 users, 1,008 items after 5-core.\nTraceback (most recent call last):\n  File "C:\\Users\\lukas\\AutoRecLab_Team7\\treesearch\\interpreter.py", line 147, in _run_session\n    exec(compile(code, self.agent_file_name, "exec"), global_scope)\n  File "runfile.py", line 214, in <module>\n    res = run_experiment(ds_name, df)\n          ^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File "runfile.py", line 174, in run_experiment\n    train, test = holdout_split(df, seed)\n                  ^^^^^^^^^^^^^^^^^^^^^^^\n  File "runfile.py", line 162, in holdout_split\n    splitter = xf.SampleFrac(0.2, seed=seed, disjoint=True)\n               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\nTypeError: SampleFrac.__init__() got an unexpected keyword argument \'seed\'\nExecution time: a second seconds (time limit is an hour).\n```', 'Instructions': ['Carefully analyze the execution output for signs of bugs or failures:', '- Syntax errors, import errors, or runtime exceptions', '- Missing required outputs or metrics', '- Execution timeouts or crashes', '- Incorrect or nonsensical results', '', "If there's a bug, provide a clear summary of the issue and suggest how to fix it.", 'If the execution was successful, leave the summary empty.']}
