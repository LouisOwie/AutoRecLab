rt pandas as pd\\nimport matplotlib.pyplot as plt\\n\\nexperiment_data = {\\n    \'movielens100k\': {\\n        \'metrics\': {\'train\': [], \'val\': []},\\n        \'losses\': {\'train\': [], \'val\': []},\\n        \'predictions\': [],\\n        \'ground_truth\': [],\\n        \'timestamps\': [],\\n    }\\n}\\n\\n# Locate dataset\\ncandidates = [\\n    \'u.data\',\\n    os.path.join(\'ml-100k\', \'u.data\'),\\n    os.path.join(\'data\', \'u.data\'),\\n    os.path.join(\'data\', \'ml-100k\', \'u.data\'),\\n]\\npath = next((p for p in candidates if os.path.exists(p)), None)\\nif path is None:\\n    raise FileNotFoundError(\'Could not find MovieLens100k u.data in expected locations.\')\\n\\n# Load full ratings data\\ncols = [\'user\', \'item\', \'rating\', \'timestamp\']\\ndf = pd.read_csv(path, sep=\'\\\\t\', names=cols, engine=\'python\')\\ndf[\'user\'] = df[\'user\'].astype(int)\\ndf[\'item\'] = df[\'item\'].astype(int)\\ndf[\'rating\'] = df[\'rating\'].astype(float)\\ndf[\'timestamp\'] = df[\'timestamp\'].astype(np.int64)\\ndf[\'datetime\'] = pd.to_datetime(df[\'timestamp\'], unit=\'s\', utc=True)\\n\\n# Optional LensKit consistency check\\nlenskit_counts = {}\\ntry:\\n    from lenskit.datasets import ML100K\\n    ds_dir = os.path.dirname(path) or \'.\'\\n    if os.path.basename(ds_dir) != \'ml-100k\' and os.path.exists(os.path.join(ds_dir, \'ml-100k\')):\\n        ds_dir = os.path.join(ds_dir, \'ml-100k\')\\n    ds = ML100K(ds_dir)\\n    lk_ratings = ds.ratings.copy()\\n    lenskit_counts = {\\n        \'users\': int(lk_ratings[\'user\'].nunique()),\\n        \'items\': int(lk_ratings[\'item\'].nunique()),\\n        \'ratings\': int(len(lk_ratings))\\n    }\\nexcept Exception as e:\\n    lenskit_counts = {\'warning\': str(e)}\\n\\n# Core requested statistics\\nn_users = int(df[\'user\'].nunique())\\nn_items = int(df[\'item\'].nunique())\\nactivity = df.groupby(\'user\').size().sort_values(ascending=False)\\ntop3 = activity.head(3)\\nmost_active_user = int(top3.index[0])\\nmost_active_user_mean = float(df.loc[df[\'user\'] == most_active_user, \'rating\'].mean())\\n\\nusers_50 = set(df.loc[df[\'item\'] == 50, \'user\'].unique().tolist())\\nusers_181 = set(df.loc[df[\'item\'] == 181, \'user\'].unique().tolist())\\ncooccurrence = int(len(users_50 & users_181))\\n\\nexpected_start = pd.Timestamp(\'1997-01-01\', tz=\'UTC\')\\nexpected_end = pd.Timestamp(\'1998-12-31 23:59:59\', tz=\'UTC\')\\nout_of_range = df[(df[\'datetime\'] < expected_start) | (df[\'datetime\'] > expected_end)].copy()\\n\\n# Save plottable data\\nuser_counts = activity.sort_index()\\nnp.save(os.path.join(working_dir, \'movielens100k_user_ids.npy\'), user_counts.index.to_numpy())\\nnp.save(os.path.join(working_dir, \'movielens100k_user_rating_counts.npy\'), user_counts.values)\\nnp.save(os.path.join(working_dir, \'movielens100k_timestamps.npy\'), df[\'timestamp\'].to_numpy())\\nnp.save(os.path.join(working_dir, \'movielens100k_out_of_range_timestamps.npy\'), out_of_range[\'timestamp\'].to_numpy())\\n\\n# Simple visualization\\nplt.figure(figsize=(8, 4))\\nplt.hist(user_counts.values, bins=30, color=\'steelblue\', edgecolor=\'black\')\\nplt.xlabel(\'Ratings per user\')\\nplt.ylabel(\'Number of users\')\\nplt.title(\'MovieLens100k User Activity Distribution\')\\nplt.tight_layout()\\nplt.savefig(os.path.join(working_dir, \'movielens100k_user_activity_distribution.png\'), dpi=150)\\nplt.close()\\n\\n# Required logging placeholder\\nval_loss = float(len(out_of_range))\\nexperiment_data[\'movielens100k\'][\'losses\'][\'val\'].append({\'epoch\': 0, \'value\': val_loss})\\nexperiment_data[\'movielens100k\'][\'metrics\'][\'train\'].append({\'name\': \'n_users\', \'value\': n_users})\\nexperiment_data[\'movielens100k\'][\'metrics\'][\'train\'].append({\'name\': \'n_items\', \'value\': n_items})\\nexperiment_data[\'movielens100k\'][\'metrics\'][\'val\'].append({\'name\': \'cooccurrence_item50_item181\', \'value\': cooccurrence})\\nexperiment_data[\'movielens100k\'][\'predictions\'] = top3.to_dict()\\nexperiment_data[\'movielens100k\'][\'ground_truth\'] = {\\n    \'most_active_user_mean_rating\': most_active_user_mean,\\n    \'out_of_range_count\': int(len(out_of_range))\\n}\\nexperiment_data[\'movielens100k\'][\'timestamps\'].append(pd.Timestamp.utcnow().isoformat())\\nprint(f\'Epoch 0: validation_loss = {val_loss:.4f}\')\\n\\n# Print requested answers\\nprint(f\'Total unique user_ids: {n_users}\')\\nprint(f\'Total unique item_ids: {n_items}\')\\nprint(\'Top 3 most active users by rating count:\')\\nfor rank, (uid, cnt) in enumerate(top3.items(), start=1):\\n    print(f\'#{rank}: user {int(uid)} with {int(cnt)} ratings\')\\nprint(f\'Mean rating for most active user {most_active_user}: {most_active_user_mean:.4f}\')\\nprint(f\'Users who rated both item 50 and item 181: {cooccurrence}\')\\nif len(out_of_range) == 0:\\n    print(\'No timestamps fall outside the expected 1997-1998 range.\')\\nelse:\\n    print(f\'Found {len(out_of_range)} timestamps outside the expected 1997-1998 range.\')\\n    print(out_of_range[[\'user\', \'item\', \'rating\', \'timestamp\', \'datetime\']].head(10).to_string(index=False))\\n\\nif \'users\' in lenskit_counts:\\n    print(\'LensKit consistency check:\', lenskit_counts)\\nelse:\\n    print(\'LensKit consistency check unavailable:\', lenskit_counts.get(\'warning\', \'unknown error\'))\\n\\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\\nprint(f\'Saved outputs to: {working_dir}\')"}', name='return_plan_and_code'), type='function')]))[/cyan]
