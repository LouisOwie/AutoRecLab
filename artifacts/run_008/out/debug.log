: []},\\n    \'lastfm\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\\n}\\n\\nSEEDS = [1, 7, 21, 42, 84]\\nKS = [1, 5, 10]\\n\\n\\ndef resolve_path(candidates):\\n    search_dirs = [os.getcwd(), working_dir]\\n    for cand in candidates:\\n        if os.path.isabs(cand) and os.path.exists(cand):\\n            return cand\\n        for d in search_dirs:\\n            p = os.path.join(d, cand)\\n            if os.path.exists(p):\\n                return p\\n    return None\\n\\n\\ndef k_core_filter(df, user_col=\'user\', item_col=\'item\', min_uc=5, min_ic=5):\\n    cur = df[[user_col, item_col]].drop_duplicates().copy()\\n    while True:\\n        nu = cur.groupby(user_col)[item_col].size()\\n        ni = cur.groupby(item_col)[user_col].size()\\n        keep_u = nu[nu >= min_uc].index\\n        keep_i = ni[ni >= min_ic].index\\n        nxt = cur[cur[user_col].isin(keep_u) & cur[item_col].isin(keep_i)]\\n        if len(nxt) == len(cur):\\n            break\\n        cur = nxt\\n    return cur.reset_index(drop=True)\\n\\n\\ndef load_ml100k(path=None):\\n    path = resolve_path([path] if path else [\'u.data\', \'ml-100k/u.data\'])\\n    if path is None:\\n        raise FileNotFoundError(\'MovieLens100K file not found. Expected one of: u.data, ml-100k/u.data\')\\n    df = pd.read_csv(path, sep=\'\\\\t\', header=None, names=[\'user\', \'item\', \'rating\', \'timestamp\'])\\n    df[\'rating\'] = pd.to_numeric(df[\'rating\'], errors=\'coerce\')\\n    df = df[df[\'rating\'] > 3][[\'user\', \'item\']].dropna().copy()\\n    df[\'user\'] = df[\'user\'].astype(str)\\n    df[\'item\'] = df[\'item\'].astype(str)\\n    return k_core_filter(df)\\n\\n\\ndef load_amazon(path=None):\\n    path = resolve_path([path] if path else [\'VideoGames.csv\', \'video_games.csv\', \'ratings_Video_Games.csv\', \'Video_Games.csv\'])\\n    if path is None:\\n        raise FileNotFoundError(\'Amazon Video Games file not found. Expected one of: VideoGames.csv, video_games.csv, ratings_Video_Games.csv, Video_Games.csv\')\\n    raw = pd.read_csv(path, header=None)\\n    if raw.shape[1] >= 4:\\n        raw = raw.iloc[:, :4]\\n        raw.columns = [\'user\', \'item\', \'rating\', \'timestamp\']\\n    elif raw.shape[1] == 3:\\n        raw.columns = [\'user\', \'item\', \'rating\']\\n    else:\\n        raise ValueError(f\'Amazon file has unsupported number of columns: {raw.shape[1]}\')\\n    raw[\'rating\'] = pd.to_numeric(raw[\'rating\'], errors=\'coerce\')\\n    df = raw[raw[\'rating\'] > 3][[\'user\', \'item\']].dropna().copy()\\n    df[\'user\'] = df[\'user\'].astype(str)\\n    df[\'item\'] = df[\'item\'].astype(str)\\n    return k_core_filter(df)\\n\\n\\ndef load_lastfm(path=None):\\n    path = resolve_path([path] if path else [\'user_taggedartists-timestamps.dat\'])\\n    if path is None:\\n        raise FileNotFoundError(\'Last.FM file not found. Expected: user_taggedartists-timestamps.dat\')\\n    df = pd.read_csv(path, sep=\'\\\\t\')\\n    low = {c.lower(): c for c in df.columns}\\n    user_col = low.get(\'userid\', df.columns[0])\\n    item_col = low.get(\'artistid\', df.columns[1])\\n    df = df[[user_col, item_col]].dropna().copy()\\n    df.columns = [\'user\', \'item\']\\n    df[\'user\'] = df[\'user\'].astype(str)\\n    df[\'item\'] = df[\'item\'].astype(str)\\n    return k_core_filter(df)\\n\\n\\ndef user_holdout(interactions, test_frac=0.2, seed=42):\\n    rng = np.random.default_rng(seed)\\n    train_parts, test_parts = [], []\\n    for _, grp in interactions.groupby(\'user\', sort=False):\\n        grp = grp.sample(frac=1.0, random_state=int(rng.integers(0, 2**31 - 1))).reset_index(drop=True)\\n        n = len(grp)\\n        if n < 2:\\n            train_parts.append(grp)\\n            continue\\n        n_test = max(1, int(np.ceil(n * test_frac)))\\n        n_test = min(n_test, n - 1)\\n        test_parts.append(grp.iloc[:n_test])\\n        train_parts.append(grp.iloc[n_test:])\\n    train = pd.concat(train_parts, ignore_index=True) if train_parts else interactions.iloc[0:0].copy()\\n    test = pd.concat(test_parts, ignore_index=True) if test_parts else interactions.iloc[0:0].copy()\\n    return train, test\\n\\n\\ndef build_algorithms():\\n    return {\\n        \'ALS\': ImplicitMF(features=50, iterations=10, reg=0.1, weight=40),\\n        \'ItemKNN\': ItemItem(nnbrs=20, min_nbrs=1, min_sim=1.0e-6, center=False),\\n        \'Pop\': Popular(),\\n    }\\n\\n\\ndef fit_algo(algo, train):\\n    tr = train[[\'user\', \'item\']].copy()\\n    tr[\'rating\'] = 1.0\\n    algo.fit(tr)\\n    return algo\\n\\n\\ndef recommend_algo(algo, user, n, candidates=None):\\n    try:\\n        recs = algo.recommend(user, n, candidates=candidates)\\n    except TypeError:\\n        recs = algo.recommend(user, n)\\n        if candidates is not None and recs is not None and len(recs) > 0 and isinstance(recs, pd.DataFrame):\\n            recs = recs[recs[\'item\'].isin(list(candidates))].head(n)\\n    except Exception:\\n        return []\\n    if recs is None:\\n        return []\\n    if isinstance(recs, pd.DataFrame):\\n        return recs[\'item\'].astype(str).tolist()\\n    return list(recs)\\n\\n\\ndef precision_at_k(rec_items, gt_items, k):\\n    rec_k = rec_items[:k]\\n    return 0.0 if k <= 0 else sum(1 for x in rec_k if x in gt_items) / float(k)\\n\\n\\ndef ndcg_at_k(rec_items, gt_items, k):\\n    rec_k = rec_items[:k]\\n    if not gt_items:\\n        return 0.0\\n    dcg = sum((1.0 / np.log2(i + 2)) for i, item in enumerate(rec_k) if item in gt_items)\\n    ideal_hits = min(len(gt_items), k)\\n    idcg = sum(1.0 / np.log2(i + 2) for i in range(ideal_hits))\\n    return 0.0 if idcg == 0 else dcg / idcg\\n\\n\\ndef evaluate(algo, train, test, k_list=(1, 5, 10)):\\n    train_items = train.groupby(\'user\')[\'item\'].apply(set).to_dict()\\n    test_items = test.groupby(\'user\')[\'item\'].apply(set).to_dict()\\n    all_items = set(train[\'item\'].unique())\\n    rows, pred_dump, gt_dump = [], [], []\\n    users = sorted(set(test_items) & set(train_items))\\n    for user in users:\\n        seen = train_items.get(user, set())\\n        gt = test_items.get(user, set())\\n        if not gt:\\n            continue\\n        candidates = list(all_items - seen)\\n        recs = recommend_algo(algo, user, max(k_list), candidates=candidates)\\n        pred_dump.append({\'user\': user, \'items\': recs})\\n        gt_dump.append({\'user\': user, \'items\': list(gt)})\\n        row = {\'user\': user}\\n        for k in k_list:\\n            row[f\'Precision@{k}\'] = precision_at_k(recs, gt, k)\\n            row[f\'nDCG@{k}\'] = ndcg_at_k(recs, gt, k)\\n        rows.append(row)\\n    res = pd.DataFrame(rows)\\n    metrics = {c: float(res[c].mean()) if len(res) else 0.0 for c in res.columns if c != \'user\'}\\n    return metrics, pred_dump, gt_dump\\n\\n\\ndatasets = {\\n    \'ml100k\': load_ml100k(),\\n    \'amazon_videogames\': load_amazon(),\\n    \'lastfm\': load_lastfm(),\\n}\\n\\nmeta_rows = []\\nall_results = []\\nfor dname, df in datasets.items():\\n    print(f\'Loaded {dname}: users={df.user.nunique()}, items={df.item.nunique()}, interactions={len(df)}\')\\n    meta_rows.append({\'dataset\': dname, \'users\': int(df.user.nunique()), \'items\': int(df.item.nunique()), \'interactions\': int(len(df))})\\n    np.save(os.path.join(working_dir, f\'{dname}_interactions.npy\'), df[[\'user\', \'item\']].to_numpy(dtype=object))\\n    for seed in SEEDS:\\n        train, test = user_holdout(df, test_frac=0.2, seed=seed)\\n        print(f\'{dname} seed={seed}: train={len(train)} test={len(test)}\')\\n        print(f\'Epoch {seed}: validation_loss = {0.0:.4f}\')\\n        for aname, algo in build_algorithms().items():\\n            model = fit_algo(algo, train)\\n            metrics, preds, gts = evaluate(model, train, test, KS)\\n            row = {\'dataset\': dname, \'algorithm\': aname, \'seed\': seed}\\n            row.update(metrics)\\n            all_results.append(row)\\n            experiment_data[dname][\'metrics\'][\'train\'].append({\'epoch\': seed, \'algorithm\': aname, \'n_train\': int(len(train))})\\n            experiment_data[dname][\'metrics\'][\'val\'].append({\'epoch\': seed, \'algorithm\': aname, **metrics})\\n            experiment_data[dname][\'losses\'][\'train\'].append({\'epoch\': seed, \'algorithm\': aname, \'train_loss\': 0.0})\\n            experiment_data[dname][\'losses\'][\'val\'].append({\'epoch\': seed, \'algorithm\': aname, \'validation_loss\': 0.0})\\n            experiment_data[dname][\'predictions\'].append({\'epoch\': seed, \'algorithm\': aname, \'predictions\': preds})\\n            experiment_data[dname][\'ground_truth\'].append({\'epoch\': seed, \'algorithm\': aname, \'ground_truth\': gts})\\n            print(f\\"{dname} | {aname} | seed={seed} | \\" + \' \'.join(f\'{k}={metrics[k]:.4f}\' for k in sorted(metrics)))\\n\\nresults_df = pd.DataFrame(all_results)\\nresults_path = os.path.join(working_dir, \'seed_sensitivity_results.csv\')\\nresults_df.to_csv(results_path, index=False)\\nnp.save(os.path.join(working_dir, \'seed_sensitivity_results.npy\'), results_df.to_records(index=False))\\n\\nsummary = results_df.groupby([\'dataset\', \'algorithm\']).agg([\'mean\', \'std\']) if len(results_df) else pd.DataFrame()\\nprint(\'\\\\nSummary over seeds:\')\\nprint(summary)\\nsummary.to_csv(os.path.join(working_dir, \'seed_sensitivity_summary.csv\'))\\nnp.save(os.path.join(working_dir, \'seed_sensitivity_summary.npy\'), summary.to_records() if len(summary) else np.array([], dtype=object))\\n\\nstats_rows = []\\nmetrics_list = [f\'Precision@{k}\' for k in KS] + [f\'nDCG@{k}\' for k in KS]\\nfor dname in results_df[\'dataset\'].unique():\\n    sdf = results_df[results_df[\'dataset\'] == dname]\\n    for metric in metrics_list:\\n        pivot = sdf.pivot(index=\'seed\', columns=\'algorithm\', values=metric)\\n        algs = list(pivot.columns)\\n      