.to_numeric(raw[\'rating\'], errors=\'coerce\')\n    df = raw[raw[\'rating\'] > 3][[\'user\', \'item\']].dropna().copy()\n    return k_core_filter(df)\n\n\ndef load_lastfm(path=\'user_taggedartists-timestamps.dat\'):\n    df = pd.read_csv(path, sep=\'\\t\')\n    cols = {str(c).lower(): c for c in df.columns}\n    user_col = cols.get(\'userid\', df.columns[0])\n    item_col = cols.get(\'artistid\', df.columns[1])\n    df = df[[user_col, item_col]].copy()\n    df.columns = [\'user\', \'item\']\n    return k_core_filter(df)\n\n\ndef user_holdout(interactions, test_frac=0.2, seed=42):\n    rng = np.random.default_rng(seed)\n    train_parts, test_parts = [], []\n    for _, grp in interactions.groupby(\'user\', sort=False):\n        grp = grp.sample(frac=1.0, random_state=seed)\n        n = len(grp)\n        n_test = max(1, int(np.ceil(n * test_frac))) if n >= 2 else 0\n        n_test = min(n_test, max(0, n - 1))\n        if n_test > 0:\n            test_idx = rng.choice(n, size=n_test, replace=False)\n            mask = np.zeros(n, dtype=bool)\n            mask[test_idx] = True\n            test_parts.append(grp.iloc[mask])\n            train_parts.append(grp.iloc[~mask])\n        else:\n            train_parts.append(grp)\n    train = pd.concat(train_parts, ignore_index=True) if train_parts else pd.DataFrame(columns=[\'user\', \'item\'])\n    test = pd.concat(test_parts, ignore_index=True) if test_parts else pd.DataFrame(columns=[\'user\', \'item\'])\n    return train, test\n\n\ndef build_algorithms():\n    return {\n        \'ALS\': ImplicitMF(features=50, iterations=10, reg=0.1, weight=40),\n        \'ItemKNN\': ItemItem(nnbrs=20, min_nbrs=1, min_sim=1.0e-6, center=False),\n        \'Pop\': Popular(),\n    }\n\n\ndef fit_algo(algo, train):\n    tr = train[[\'user\', \'item\']].copy()\n    tr[\'rating\'] = 1.0\n    algo.fit(tr)\n    return algo\n\n\ndef recommend_algo(algo, user, n, candidates=None):\n    try:\n        recs = algo.recommend(user, n, candidates=candidates)\n    except TypeError:\n        recs = algo.recommend(user, n)\n        if candidates is not None and recs is not None and len(recs) > 0:\n            recs = recs[recs[\'item\'].isin(list(candidates))].head(n)\n    except Exception:\n        return []\n    if recs is None:\n        return []\n    if isinstance(recs, pd.DataFrame):\n        return recs[\'item\'].tolist()\n    return list(recs)\n\n\ndef precision_at_k(rec_items, gt_items, k):\n    rec_k = rec_items[:k]\n    return 0.0 if k <= 0 or len(rec_k) == 0 else sum(1 for x in rec_k if x in gt_items) / float(k)\n\n\ndef ndcg_at_k(rec_items, gt_items, k):\n    rec_k = rec_items[:k]\n    if not gt_items:\n        return 0.0\n    dcg = sum((1.0 / np.log2(i + 2)) for i, item in enumerate(rec_k) if item in gt_items)\n    ideal_hits = min(len(gt_items), k)\n    idcg = sum(1.0 / np.log2(i + 2) for i in range(ideal_hits))\n    return 0.0 if idcg == 0 else dcg / idcg\n\n\ndef evaluate(algo, train, test, k_list=(1, 5, 10)):\n    train_items = train.groupby(\'user\')[\'item\'].apply(set).to_dict()\n    test_items = test.groupby(\'user\')[\'item\'].apply(set).to_dict()\n    all_items = set(train[\'item\'].unique())\n    rows, pred_dump, gt_dump = [], [], []\n    users = sorted(set(train_items) & set(test_items))\n    for user in users:\n        seen = train_items.get(user, set())\n        gt = test_items.get(user, set())\n        candidates = list(all_items - seen)\n        recs = recommend_algo(algo, user, max(k_list), candidates=candidates)\n        pred_dump.append({\'user\': user, \'items\': recs})\n        gt_dump.append({\'user\': user, \'items\': sorted(gt)})\n        row = {\'user\': user}\n        for k in k_list:\n            row[f\'Precision@{k}\'] = precision_at_k(recs, gt, k)\n            row[f\'nDCG@{k}\'] = ndcg_at_k(recs, gt, k)\n        rows.append(row)\n    res = pd.DataFrame(rows)\n    metrics = {c: float(res[c].mean()) if c in res else 0.0 for c in [f\'Precision@{k}\' for k in k_list] + [f\'nDCG@{k}\' for k in k_list]}\n    return metrics, pred_dump, gt_dump\n\n\ndef short_stat_summary(results_df):\n    lines = []\n    metric_cols = [f\'Precision@{k}\' for k in KS] + [f\'nDCG@{k}\' for k in KS]\n    for dname in sorted(results_df[\'dataset\'].unique()):\n        sdf = results_df[results_df[\'dataset\'] == dname]\n        lines.append(f\'Dataset: {dname}\')\n        for metric in metric_cols:\n            grp = sdf.groupby(\'algorithm\')[metric].agg([\'mean\', \'std\']).sort_values(\'mean\', ascending=False)\n            top = grp.index[0]\n            spread = grp.loc[top, \'std\']\n            lines.append(f\'  {metric}: best_mean={top} ({grp.loc[top, "mean"]:.4f}), seed_std={spread:.4f}\')\n    return \'\\n\'.join(lines)\n\n\ndatasets = {\n    \'ml100k\': load_ml100k(\'u.data\'),\n    \'amazon_videogames\': load_amazon(\'VideoGames.csv\'),\n    \'lastfm\': load_lastfm(\'user_taggedartists-timestamps.dat\'),\n}\n\nall_results = []\nfor dname, df in datasets.items():\n    print(f\'Loaded {dname}: users={df.user.nunique()}, items={df.item.nunique()}, interactions={len(df)}\')\n    np.save(os.path.join(working_dir, f\'{dname}_interactions.npy\'), df[[\'user\', \'item\']].to_numpy(dtype=object))\n    for seed in SEEDS:\n        train, test = user_holdout(df, test_frac=0.2, seed=seed)\n        print(f\'{dname} seed={seed}: train={len(train)} test={len(test)}\')\n        print(f\'Epoch {seed}: validation_loss = {0.0:.4f}\')\n        for aname, algo in build_algorithms().items():\n            model = fit_algo(algo, train)\n            metrics, preds, gts = evaluate(model, train, test, KS)\n            row = {\'dataset\': dname, \'algorithm\': aname, \'seed\': seed}\n            row.update(metrics)\n            all_results.append(row)\n            experiment_data[dname][\'metrics\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'n_train\': len(train), \'timestamp\': seed})\n            experiment_data[dname][\'metrics\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, \'timestamp\': seed, **metrics})\n            experiment_data[dname][\'losses\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'epoch\': seed, \'train_loss\': 0.0})\n            experiment_data[dname][\'losses\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, \'epoch\': seed, \'validation_loss\': 0.0})\n            experiment_data[dname][\'predictions\'].append({\'seed\': seed, \'algorithm\': aname, \'predictions\': preds})\n            experiment_data[dname][\'ground_truth\'].append({\'seed\': seed, \'algorithm\': aname, \'ground_truth\': gts})\n            print(f"{dname} | {aname} | seed={seed} | " + \' \'.join([f\'{k}={metrics[k]:.4f}\' for k in sorted(metrics)]))\n\nresults_df = pd.DataFrame(all_results)\nresults_csv = os.path.join(working_dir, \'seed_sensitivity_results.csv\')\nresults_df.to_csv(results_csv, index=False)\nnp.save(os.path.join(working_dir, \'seed_sensitivity_results.npy\'), results_df.to_records(index=False))\n\nsummary = results_df.groupby([\'dataset\', \'algorithm\']).agg([\'mean\', \'std\'])\nprint(\'\\nSummary over seeds:\')\nprint(summary)\nsummary.to_csv(os.path.join(working_dir, \'seed_sensitivity_summary.csv\'))\nnp.save(os.path.join(working_dir, \'seed_sensitivity_summary.npy\'), summary.to_records())\n\nstats_rows = []\nfor dname in results_df[\'dataset\'].unique():\n    sdf = results_df[results_df[\'dataset\'] == dname]\n    for metric in [f\'Precision@{k}\' for k in KS] + [f\'nDCG@{k}\' for k in KS]:\n        pivot = sdf.pivot(index=\'seed\', columns=\'algorithm\', values=metric)\n        algs = list(pivot.columns)\n        for i in range(len(algs)):\n            for j in range(i + 1, len(algs)):\n                a, b = algs[i], algs[j]\n                x, y = pivot[a].values, pivot[b].values\n                if len(x) > 1 and len(y) > 1:\n                    t, p = stats.ttest_rel(x, y)\n                else:\n                    t, p = np.nan, np.nan\n                stats_rows.append({\n   