b.pyplot as plt\n    HAS_MPL = True\nexcept Exception:\n    plt = None\n    HAS_MPL = False\n\nfrom lenskit.algorithms.basic import Popular\nfrom lenskit.algorithms.als import ImplicitMF\nfrom lenskit.algorithms.item_knn import ItemItem\n\nSEEDS = [1, 7, 21, 42, 84]\nKS = [1, 5, 10]\n\nexperiment_data = {\n    \'ml100k\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\n    \'amazon_videogames\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\n    \'lastfm\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\n}\n\n\ndef k_core_filter(df, user_col=\'user\', item_col=\'item\', min_uc=5, min_ic=5):\n    cur = df[[user_col, item_col]].drop_duplicates().copy()\n    while True:\n        nu = cur.groupby(user_col)[item_col].size()\n        ni = cur.groupby(item_col)[user_col].size()\n        keep_u = nu[nu >= min_uc].index\n        keep_i = ni[ni >= min_ic].index\n        nxt = cur[cur[user_col].isin(keep_u) & cur[item_col].isin(keep_i)]\n        if len(nxt) == len(cur):\n            break\n        cur = nxt\n    return cur.reset_index(drop=True)\n\n\ndef load_ml100k(path=\'u.data\'):\n    df = pd.read_csv(path, sep=\'\\t\', header=None, names=[\'user\', \'item\', \'rating\', \'timestamp\'])\n    df[\'rating\'] = pd.to_numeric(df[\'rating\'], errors=\'coerce\')\n    df = df[df[\'rating\'] > 3][[\'user\', \'item\']].dropna().copy()\n    return k_core_filter(df)\n\n\ndef load_amazon(path=\'VideoGames.csv\'):\n    raw = pd.read_csv(path, header=None)\n    raw = raw.iloc[:, :4] if raw.shape[1] >= 4 else raw.iloc[:, :3]\n    cols = [\'user\', \'item\', \'rating\', \'timestamp\'][:raw.shape[1]]\n    raw.columns = cols\n    raw[\'rating\'] = pd.to_numeric(raw[\'rating\'], errors=\'coerce\')\n    df = raw[raw[\'rating\'] > 3][[\'user\', \'item\']].dropna().copy()\n    return k_core_filter(df)\n\n\ndef load_lastfm(path=\'user_taggedartists-timestamps.dat\'):\n    df = pd.read_csv(path, sep=\'\\t\')\n    low = {c.lower(): c for c in df.columns}\n    ucol = low.get(\'userid\', df.columns[0])\n    icol = low.get(\'artistid\', df.columns[1])\n    df = df[[ucol, icol]].copy()\n    df.columns = [\'user\', \'item\']\n    return k_core_filter(df)\n\n\ndef user_holdout(interactions, test_frac=0.2, seed=42):\n    rng = np.random.default_rng(seed)\n    train_parts, test_parts = [], []\n    for _, grp in interactions.groupby(\'user\', sort=False):\n        grp = grp.sample(frac=1, random_state=seed)\n        n = len(grp)\n        if n < 2:\n            train_parts.append(grp)\n            continue\n        n_test = max(1, int(round(n * test_frac)))\n        n_test = min(n_test, n - 1)\n        idx = rng.choice(n, size=n_test, replace=False)\n        mask = np.zeros(n, dtype=bool)\n        mask[idx] = True\n        test_parts.append(grp.iloc[mask])\n        train_parts.append(grp.iloc[~mask])\n    train = pd.concat(train_parts, ignore_index=True) if train_parts else pd.DataFrame(columns=[\'user\', \'item\'])\n    test = pd.concat(test_parts, ignore_index=True) if test_parts else pd.DataFrame(columns=[\'user\', \'item\'])\n    return train, test\n\n\ndef build_algorithms():\n    return {\n        \'ALS\': ImplicitMF(features=50, iterations=10, reg=0.1, weight=40),\n        \'ItemKNN\': ItemItem(nnbrs=20, min_nbrs=1, min_sim=1.0e-6, center=False),\n        \'Pop\': Popular(),\n    }\n\n\ndef fit_algo(algo, train):\n    tr = train.copy()\n    tr[\'rating\'] = 1.0\n    algo.fit(tr)\n    return algo\n\n\ndef recommend_algo(algo, user, n, candidates=None):\n    try:\n        recs = algo.recommend(user, n, candidates=candidates)\n    except TypeError:\n        recs = algo.recommend(user, n)\n        if candidates is not None and recs is not None and len(recs) > 0:\n            recs = recs[recs[\'item\'].isin(list(candidates))].head(n)\n    except Exception:\n        recs = None\n    if recs is None:\n        return []\n    if isinstance(recs, pd.DataFrame):\n        return recs[\'item\'].tolist()\n    return list(recs)\n\n\ndef precision_at_k(rec_items, gt_items, k):\n    rec_k = rec_items[:k]\n    return 0.0 if k == 0 or len(rec_k) == 0 else sum(x in gt_items for x in rec_k) / float(k)\n\n\ndef ndcg_at_k(rec_items, gt_items, k):\n    rec_k = rec_items[:k]\n    if len(gt_items) == 0:\n        return 0.0\n    dcg = sum((1.0 / np.log2(i + 2)) for i, item in enumerate(rec_k) if item in gt_items)\n    ideal_hits = min(len(gt_items), k)\n    idcg = sum(1.0 / np.log2(i + 2) for i in range(ideal_hits))\n    return 0.0 if idcg == 0 else dcg / idcg\n\n\ndef evaluate(algo, train, test, k_list=(1, 5, 10)):\n    train_items = train.groupby(\'user\')[\'item\'].apply(set).to_dict()\n    test_items = test.groupby(\'user\')[\'item\'].apply(set).to_dict()\n    all_items = set(train[\'item\'].unique())\n    rows, pred_dump, gt_dump = [], [], []\n    users = sorted(set(test[\'user\']).intersection(train[\'user\']))\n    for user in users:\n        seen = train_items.get(user, set())\n        gt = test_items.get(user, set())\n        candidates = list(all_items - seen)\n        recs = recommend_algo(algo, user, max(k_list), candidates=candidates)\n        pred_dump.append({\'user\': user, \'items\': recs})\n        gt_dump.append({\'user\': user, \'items\': list(gt)})\n        row = {\'user\': user}\n        for k in k_list:\n            row[f\'Precision@{k}\'] = precision_at_k(recs, gt, k)\n            row[f\'nDCG@{k}\'] = ndcg_at_k(recs, gt, k)\n        rows.append(row)\n    res = pd.DataFrame(rows)\n    metrics = {c: (float(res[c].mean()) if len(res) else 0.0) for c in res.columns if c != \'user\'}\n    return metrics, pred_dump, gt_dump\n\n\ndatasets = {\n    \'ml100k\': load_ml100k(\'u.data\'),\n    \'amazon_videogames\': load_amazon(\'VideoGames.csv\'),\n    \'lastfm\': load_lastfm(\'user_taggedartists-timestamps.dat\'),\n}\n\nall_results = []\nfor dname, df in datasets.items():\n    print(f\'Loaded {dname}: users={df.user.nunique()}, items={df.item.nunique()}, interactions={len(df)}\')\n    np.save(os.path.join(working_dir, f\'{dname}_interactions.npy\'), df[[\'user\', \'item\']].to_numpy(dtype=object))\n    for seed in SEEDS:\n        train, test = user_holdout(df, test_frac=0.2, seed=seed)\n        print(f\'{dname} seed={seed}: train={len(train)} test={len(test)}\')\n        for aname, algo in build_algorithms().items():\n            model = fit_algo(algo, train)\n            metrics, preds, gts = evaluate(model, train, test, KS)\n            val_loss = 1.0 - metrics.get(\'nDCG@10\', 0.0)\n            print(f\'Epoch {seed}: validation_loss = {val_loss:.4f}\')\n            row = {\'dataset\': dname, \'algorithm\': aname, \'seed\': seed}\n            row.update(metrics)\n            all_results.append(row)\n            experiment_data[dname][\'metrics\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'n_train\': len(train), \'timestamp\': seed})\n            experiment_data[dname][\'metrics\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, \'timestamp\': seed, **metrics})\n            experiment_data[dname][\'losses\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'train_loss\': np.nan, \'timestamp\': seed})\n            experiment_data[dname][\'losses\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, \'validation_loss\': val_loss, \'timestamp\': seed})\n            experiment_data[dname][\'predictions\'].append({\'seed\': seed, \'algorithm\': aname, \'predictions\': preds})\n            experiment_data[dname][\'ground_truth\'].append({\'seed\': seed, \'algorithm\': aname, \'ground_truth\': gts})\n            print(f"{dname} | {aname} | seed={seed} | " + \' \'.join(f\'{k}={metrics[k]:.4f}\' for k in sorted(metrics)))\n\nresults_df = pd.DataFrame(all_results)\nresults_df.to_csv(os.path.join(working_dir, \'seed_sensitivity_results.csv\'), index=False)\nnp.save(os.path.join(working_dir, \'seed_sensitivity_results.npy\'), results_df.to_records(index=False))\n\nsummary = results_df.groupby([\'dataset\', \'algorithm\']).agg([\'mean\', \'std\'])\nprint(\'\\nSummary over seeds:\')\nprint(summary)\nsummary.to_csv(os.path.join(working_dir, \'seed_sensitivity_summary.csv\'))\n\nstats_rows = []\nfor dname in results_df[\'dataset\'].unique():\n    sdf = results_df[results_df[\'dataset\'] == dname]\n    for metric in [f\'Precision@{k}\' for k in KS] + [f\'nDCG@{k}\' for k in KS]:\n        pivot = sdf.pivot(index=\'seed\', columns=\'algorithm\', values=metric)\n        algs = list(pivot.columns)\n        for i in range(len(algs)):\n            for j in range(i + 1, len(algs)):\n                a, b = algs[i], algs[j]\n                pair = pivot[[a, b]].dropna()\n                x, y = pair[a].values, pair[b].values\n                if len(x) > 1:\n                    t, p = stats.ttest_rel(x, y)\n                else:\n                    t, p = np.nan, np.nan\n                stats_rows.append({\n                    \'dataset\': dname, \'metric\': metric, \'alg_a\': a, \'alg_b\': b,\n                    \'mean_a\': float(np.mean(x)) if len(x) else np.nan,\n                    \'mean_b\': float(np.mean(y)) if len(y) else np.nan,\n                    \'std_a\': float(np.std(x, ddof=1)) if len(x) > 1 else np.nan,\n                    \'std_b\': float(np.std(y, ddof=1)) if len(y) > 1 else np.nan,\n                    \'t_stat\': float(t) if pd.notna(t) else np.nan,\n                    \'p_value\': float(p) if pd.notna(p) else np.nan,\n                })\nstats_df = pd.DataFrame(stats_rows)\nprint(\'\\nPaired t-tests across seeds:\')\nprint(stats_df)\nstats_df.to_csv(os.path.join(working_dir, \'seed_sensitivity_stats.csv\'), index=False)\nnp.save(os.path.join(working_dir, \'seed_sensitivity_stats.npy\'), stats_df.to_records(index=False))\n\nseed_var = results_df.groupby([\'dataset\', \'algorithm\']).agg({m: [\'mean\', \'std\'] for m in [f\'Precision@{k}\' for k in KS] + [f\'nDCG@{k}\' for k in KS]})\nseed_var.to_csv(os.path.join(working_dir, \'seed_variability_analysis.csv\'))\n\nif HAS_MPL:\n    for dname in results_df[\'dataset\'].unique():\n        ddf = results_df[results_df[\'dataset\'] == dname]\n        for metric in [f\'Precision@{k}\' for k in KS] + [f\'nDCG@{k}\' for k in KS]:\n            plt.figure(figsize=(7, 4))\n            for alg in [\'ALS\', \'ItemKNN\', \'Pop\']:\n                adf = ddf[ddf[\'algorithm\'] == alg].sort_values(\'seed\')\n                plt.plot(adf[\'seed\'], adf[metric], marker=\'o\', label=alg)\n            plt.title(f\'{dname} - {metric} across random seeds\')\n            plt.xlabel(\'seed\')\n            plt.ylabel(metric)\n            plt.legend()\n            plt.tight_layout()\n            fig_path = os.path.join(working_dir, f\'{dname}_{metric.replace("@", "at")}_seeds.png\')\n            plt.savefig(fig_path, dpi=150)\n            plt.close()\n            np.save(os.path.join(working_dir, f\'{dname}_{metric.replace("@", "at")}_plotdata.npy\'), ddf[[\'seed\', \'algorithm\', metric]].to_records(index=False))\nelse:\n    print(\'\\nmatplotlib not available; skipping plot generation.\')\n    for dname in results_df[\'dataset\'].unique():\n        ddf = results_df[results_df[\'dataset\'] == dname]\n        for metric in [f\'Precision@{k}\' for k in KS] + [f\'nDCG@{k}\' for k in KS]:\n            np.save(os.path.join(working_dir, f\'{dname}_{metric.replace("@", "at")}_plotdata.npy\'), ddf[[\'seed\', \'algorithm\', metric]].to_records(index=False))\n\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\nprint(\'\\nSaved outputs to\', working_dir)\n\nprint(\'\\nShort statistical analysis:\')\nfor dname in results_df[\'dataset\'].unique():\n    print(f\'[{dname}]\')\n    dsub = results_df[results_df[\'dataset\'] == dname]\n    for metric in [\'nDCG@10\', \'Precision@10\']:\