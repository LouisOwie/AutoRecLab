ic.replace(\'@\', \'at\')}_seeds.png\'), dpi=150)\n            plt.close()\n\nwith open(os.path.join(working_dir, \'dataset_summary.json\'), \'w\', encoding=\'utf-8\') as f:\n    json.dump(meta_rows, f, indent=2)\n\nshort_analysis = []\nfor dname in results_df[\'dataset\'].unique():\n    for metric in metrics_list:\n        sub = seed_effect_df[(seed_effect_df[\'dataset\'] == dname) & (seed_effect_df[\'metric\'] == metric)]\n        if len(sub):\n            most_stable = sub.sort_values([\'std\', \'range\']).iloc[0]\n            least_stable = sub.sort_values([\'std\', \'range\'], ascending=False).iloc[0]\n            best_mean = sub.sort_values(\'mean\', ascending=False).iloc[0]\n            short_analysis.append({\n                \'dataset\': dname,\n                \'metric\': metric,\n                \'best_mean_algorithm\': best_mean[\'algorithm\'],\n                \'best_mean_value\': float(best_mean[\'mean\']),\n                \'most_stable_algorithm\': most_stable[\'algorithm\'],\n                \'most_stable_std\': float(most_stable[\'std\']) if pd.notna(most_stable[\'std\']) else np.nan,\n                \'least_stable_algorithm\': least_stable[\'algorithm\'],\n                \'least_stable_std\': float(least_stable[\'std\']) if pd.notna(least_stable[\'std\']) else np.nan,\n            })\nshort_df = pd.DataFrame(short_analysis)\nshort_df.to_csv(os.path.join(working_dir, \'seed_sensitivity_short_analysis.csv\'), index=False)\nnp.save(os.path.join(working_dir, \'seed_sensitivity_short_analysis.npy\'), short_df.to_records(index=False) if len(short_df) else np.array([], dtype=object))\n\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\nprint(\'\\nSaved outputs to\', working_dir)\n```', 'Execution Output': '```\nTraceback (most recent call last):\n  File "C:\\Users\\lukas\\AutoRecLab_Team7\\treesearch\\interpreter.py", line 147, in _run_session\n    exec(compile(code, self.agent_file_name, "exec"), global_s