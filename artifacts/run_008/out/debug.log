predictions\': [], \'ground_truth\': []},\\n}\\n\\nSEEDS = [1, 13, 42, 77, 202]\\nTOPKS = [1, 5, 10]\\nALGORITHMS = [\'ALS\', \'ItemKNN\', \'Pop\']\\n\\n\\ndef k_core_filter(df, user_col=\'user\', item_col=\'item\', min_k=5):\\n    df = df[[user_col, item_col]].dropna().drop_duplicates().copy()\\n    changed = True\\n    while changed and len(df):\\n        before = len(df)\\n        uc = df[user_col].value_counts()\\n        ic = df[item_col].value_counts()\\n        df = df[df[user_col].isin(uc[uc >= min_k].index)]\\n        df = df[df[item_col].isin(ic[ic >= min_k].index)]\\n        changed = len(df) != before\\n    return df.reset_index(drop=True)\\n\\n\\ndef load_ml100k(path=\'u.data\'):\\n    df = pd.read_csv(path, sep=\'\\\\t\', header=None, names=[\'user\', \'item\', \'rating\', \'timestamp\'])\\n    df = df[pd.to_numeric(df[\'rating\'], errors=\'coerce\') > 3][[\'user\', \'item\']].copy()\\n    return k_core_filter(df)\\n\\n\\ndef load_amazon(path=\'VideoGames.csv\'):\\n    df = pd.read_csv(path, header=None)\\n    if df.shape[1] < 3:\\n        raise ValueError(\'VideoGames.csv must contain at least 3 columns\')\\n    df = df.iloc[:, :3].copy()\\n    df.columns = [\'user\', \'item\', \'rating\']\\n    df = df[pd.to_numeric(df[\'rating\'], errors=\'coerce\') > 3][[\'user\', \'item\']].copy()\\n    return k_core_filter(df)\\n\\n\\ndef load_lastfm(path=\'user_taggedartists-timestamps.dat\'):\\n    df = pd.read_csv(path, sep=\'\\\\t\')\\n    cols = {c.lower(): c for c in df.columns}\\n    ucol = cols.get(\'userid\', list(df.columns)[0])\\n    icol = cols.get(\'artistid\', list(df.columns)[1])\\n    df = df[[ucol, icol]].copy()\\n    df.columns = [\'user\', \'item\']\\n    return k_core_filter(df)\\n\\n\\ndef user_holdout_split(df, test_ratio=0.2, seed=42):\\n    rng = np.random.default_rng(seed)\\n    train_parts, test_parts = [], []\\n    for _, g in df.groupby(\'user\', sort=False):\\n        g = g.sample(frac=1, random_state=seed).reset_index(drop=True)\\n        n = len(g)\\n        if n < 2:\\n            continue\\n        n_test = max(1, int(round(n * test_ratio)))\\n        n_test = min(n_test, n - 1)\\n        test_idx = rng.choice(np.arange(n), size=n_test, replace=False)\\n        mask = np.zeros(n, dtype=bool)\\n        mask[test_idx] = True\\n        train_parts.append(g.loc[~mask, [\'user\', \'item\']])\\n        test_parts.append(g.loc[mask, [\'user\', \'item\']])\\n    train = pd.concat(train_parts, ignore_index=True) if train_parts else pd.DataFrame(columns=[\'user\', \'item\'])\\n    test = pd.concat(test_parts, ignore_index=True) if test_parts else pd.DataFrame(columns=[\'user\', \'item\'])\\n    train_items = set(train[\'item\'])\\n    test = test[test[\'item\'].isin(train_items)].reset_index(drop=True)\\n    common_users = set(train[\'user\']).intersection(test[\'user\'])\\n    train = train[train[\'user\'].isin(common_users)].reset_index(drop=True)\\n    test = test[test[\'user\'].isin(common_users)].reset_index(drop=True)\\n    return train, test\\n\\n\\ndef get_algo(name):\\n    if name == \'ALS\':\\n        return Recommender.adapt(ImplicitMF(features=50, iterations=15, weight=40))\\n    if name == \'ItemKNN\':\\n        return Recommender.adapt(ItemItem(nnbrs=20, min_nbrs=1, center=False))\\n    if name == \'Pop\':\\n        return Recommender.adapt(Popular())\\n    raise ValueError(name)\\n\\n\\ndef dcg_at_k(rels, k):\\n    rels = np.asarray(rels)[:k]\\n    if rels.size == 0:\\n        return 0.0\\n    return float((rels / np.log2(np.arange(2, rels.size + 2))).sum())\\n\\n\\ndef ndcg_at_k(pred_items, truth_set, k):\\n    rels = np.array([1.0 if i in truth_set else 0.0 for i in pred_items[:k]])\\n    dcg = dcg_at_k(rels, k)\\n    ideal = dcg_at_k(np.ones(min(len(truth_set), k)), k)\\n    return 0.0 if ideal == 0 else dcg / ideal\\n\\n\\ndef precision_at_k(pred_items, truth_set, k):\\n    return 0.0 if k <= 0 else sum(1 for i in pred_items[:k] if i in truth_set) / k\\n\\n\\ndef evaluate_model(algo, train, test, ks=(1, 5, 10)):\\n    truth = test.groupby(\'user\')[\'item\'].apply(set).to_dict()\\n    users = sorted(truth.keys())\\n    train_seen = train.groupby(\'user\')[\'item\'].apply(set).to_dict()\\n    metrics = {f\'P@{k}\': [] for k in ks}\\n    metrics.update({f\'nDCG@{k}\': [] for k in ks})\\n    preds_dump = []\\n    n_req = max(ks)\\n    for u in users:\\n        try:\\n            recs = algo.recommend(u, n_req, candidates=None)\\n        except TypeError:\\n            try:\\n                recs = algo.recommend(u, n_req)\\n            except Exception:\\n                recs = pd.DataFrame(columns=[\'item\'])\\n        except Exception:\\n            recs = pd.DataFrame(columns=[\'item\'])\\n        items = recs[\'item\'].tolist() if isinstance(recs, pd.DataFrame) and \'item\' in recs.columns else []\\n        seen = train_seen.get(u, set())\\n        items = [i for i in items if i not in seen]\\n        preds_dump.append((u, items))\\n        gt = truth[u]\\n        for k in ks:\\n            metrics[f\'P@{k}\'].append(precision_at_k(items, gt, k))\\n            metrics[f\'nDCG@{k}\'].append(ndcg_at_k(items, gt, k))\\n    return {m: float(np.mean(v)) if len(v) else 0.0 for m, v in metrics.items()}, preds_dump, truth\\n\\n\\ndatasets = {\\n    \'ml100k\': load_ml100k(\'u.data\'),\\n    \'amazon_vgames\': load_amazon(\'VideoGames.csv\'),\\n    \'lastfm\': load_lastfm(\'user_taggedartists-timestamps.dat\'),\\n}\\n\\nall_rows = []\\nfor dname, df in datasets.items():\\n    print(f\'Loaded {dname}: {len(df)} interactions, {df.user.nunique()} users, {df.item.nunique()} items\')\\n    for seed in SEEDS:\\n        train, test = user_holdout_split(df, test_ratio=0.2, seed=seed)\\n        for aname in ALGORITHMS:\\n            print(f\'Running dataset={dname}, algo={aname}, seed={seed}\')\\n            algo = get_algo(aname)\\n            algo.fit(train)\\n            val_loss = np.nan\\n            print(f\'Epoch 0: validation_loss = {val_loss:.4f}\')\\n            res, preds, truth = evaluate_model(algo, train, test, ks=TOPKS)\\n            row = {\'dataset\': dname, \'algorithm\': aname, \'seed\': seed, \'n_train\': len(train), \'n_test\': len(test), \'epoch\': 0}\\n            row.update(res)\\n            all_rows.append(row)\\n            experiment_data[dname][\'metrics\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'epoch\': 0, \'n_train\': len(train)})\\n            experiment_data[dname][\'metrics\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, \'epoch\': 0, **res})\\n            experiment_data[dname][\'losses\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'epoch\': 0, \'train_loss\': np.nan})\\n            experiment_data[dname][\'losses\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, \'epoch\': 0, \'validation_loss\': val_loss})\\n            experiment_data[dname][\'predictions\'].append({\'seed\': seed, \'algorithm\': aname, \'epoch\': 0, \'predictions\': preds[:20]})\\n            experiment_data[dname][\'ground_truth\'].append({\'seed\': seed, \'algorithm\': aname, \'epoch\': 0, \'ground_truth\': list(truth.items())[:20]})\\n\\nresults = pd.DataFrame(all_rows)\\nprint(\'\\\\nPer-run results:\')\\nprint(results.round(4).to_string(index=False))\\n\\nsummary = results.groupby([\'dataset\', \'algorithm\'])[[c for c in results.columns if \'@\' in c]].agg([\'mean\', \'std\']).round(4)\\nprint(\'\\\\nMean ± std across seeds:\')\\nprint(summary)\\n\\nstats_rows = []\\nfor dname in datasets:\\n    sub = results[results[\'dataset\'] == dname]\\n    print(f\'\\\\nStatistical analysis for {dname}:\')\\n    for metric in [\'P@1\', \'P@5\', \'P@10\', \'nDCG@1\', \'nDCG@5\', \'nDCG@10\']:\\n        stats_line = sub.groupby(\'algorithm\')[metric].agg([\'mean\', \'std\']).round(4)\\n        print(f\' {metric}\\\\n{stats_line}\')\\n        for algo_name, vals in sub.groupby(\'algorithm\')[metric]:\\n            vals = vals.values.astype(float)\\n            stats_rows.append({\'dataset\': dname, \'algorithm\': algo_name, \'metric\': metric, \'mean\': float(np.mean(vals)), \'std\': float(np.std(vals, ddof=1)) if len(vals) > 1 else 0.0, \'cv\': float(np.std(vals, ddof=1) / np.mean(vals)) if len(vals) > 1 and np.mean(vals) != 0 else np.nan})\\n    for metric in [\'P@10\', \'nDCG@10\']:\\n        pivot = sub.pivot(index=\'seed\', columns=\'algorithm\', values=metric).dropna()\\n        if pivot.shape[0] >= 3 and pivot.shape[1] == 3:\\n            stat, p = friedmanchisquare(pivot[\'ALS\'], pivot[\'ItemKNN\'], pivot[\'Pop\'])\\n            print(f\' Friedman test on {metric}: statistic={stat:.4f}, p={p:.4f}\')\\n            stats_rows.append({\'dataset\': dname, \'algorithm\': \'ALL\', \'metric\': f\'Friedman_{metric}\', \'mean\': float(stat), \'std\': float(p), \'cv\': np.nan})\\n\\nstats_df = pd.DataFrame(stats_rows)\\n\\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\\nnp.save(os.path.join(working_dir, \'results_records.npy\'), results.to_dict(\'records\'), allow_pickle=True)\\nnp.save(os.path.join(working_dir, \'stats_records.npy\'), stats_df.to_dict(\'records\'), allow_pickle=True)\\nnp.savez_compressed(os.path.join(working_dir, \'plottable_metrics.npz\'), results=results.to_records(index=False), stats=stats_df.to_records(index=False))\\nresults.to_csv(os.path.join(working_dir, \'seed_sensitivity_results.csv\'), index=False)\\nstats_df.to_csv(os.path.join(working_dir, \'seed_sensitivity_stats.csv\'), index=False)\\n\\ntry:\\n    import matplotlib.pyplot as plt\\n    for dname in datasets:\\n        sub = results[results[\'dataset\'] == dname]\\n        for metric in [\'P@10\', \'nDCG@10\']:\\n            plt.figure(figsize=(7, 4))\\n            for aname in ALGORITHMS:\\n                ss = sub[sub[\'algorithm\'] == aname].sort_values(\'seed\')\\n                plt.plot(ss[\'seed\'], ss[metric], marker=\'o\', label=aname)\\n            plt.title(f\'{dname}: {metric} across split seeds\')\\n            plt.xlabel(\'Seed\')\\n            plt.ylabel(metric)\\n            plt.legend()\\n            plt.tight_layout()\\n            fig_path = os.path.join(working_dir, f\'{dname}_{metric.replace(\\"@\\", \\"at\\")}_seed_variation.png\')\\n            plt.savefig(fig_path, dpi=150)\\n            plt.close()\\n    print(\'\\\\nPlots saved to:\', working_dir)\\nexcept ImportError:\\n    print(\'\\\\nmatplotlib not available; skipping plot generation.\')\\n\\nprint(\'\\\\nSaved outputs to:\', working_dir)"}', name='return_plan_and_code'), type='function')]))[/cyan]
