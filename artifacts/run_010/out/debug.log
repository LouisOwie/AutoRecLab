from lenskit import topn

def evaluate_model(algo, train, test):
    algo.fit(train)
    users = sorted(test['user'].unique().tolist())
    rec_frames = []
    for u in users:
        try:
            ur = algo.recommend(u, MAX_REC)
            if ur is not None and len(ur):
                ur = ur.copy()
                ur['user'] = u
                rec_frames.append(ur[['user', 'item']])
        except Exception:
            pass
    recs = pd.concat(rec_frames, ignore_index=True) if rec_frames else pd.DataFrame(columns=['user','item'])
    ...
```
or, if supported:
