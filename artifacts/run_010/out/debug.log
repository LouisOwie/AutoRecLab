ired_tests.csv\'), index=False)\nnp.save(os.path.join(working_dir, \'results_array.npy\'), results_df.to_records(index=False))\nnp.save(os.path.join(working_dir, \'summary_array.npy\'), summary_df.to_records(index=False))\nnp.save(os.path.join(working_dir, \'analysis_array.npy\'), analysis_df.to_records(index=False))\nnp.save(os.path.join(working_dir, \'paired_tests_array.npy\'), paired_df.to_records(index=False))\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\nnp.savez_compressed(os.path.join(working_dir, \'metrics_tables.npz\'),\n                    results=results_df.to_records(index=False),\n                    summary=summary_df.to_records(index=False),\n                    analysis=analysis_df.to_records(index=False),\n                    paired=paired_df.to_records(index=False))\n\nplot_status = []\nfor metric in metric_cols:\n    ok1 = plot_metric_bars(results_df, metric, f\'{metric.replace(\'@\', \'_at_\')}_by_dataset.png\') if len(results_df) else False\n    ok2 = plot_seed_lines(results_df, metric, f\'{metric.replace(\'@\', \'_at_\')}_by_seed.png\') if len(results_df) else False\n    plot_status.append((metric, ok1, ok2))\nnp.save(os.path.join(working_dir, \'plot_status.npy\'), np.array(plot_status, dtype=object))\n\nfor dname in datasets.keys():\n    sub = results_df[results_df[\'dataset\'] == dname].copy() if len(results_df) else pd.DataFrame(columns=[\'dataset\', \'algorithm\', \'seed\'] + metric_cols)\n    np.save(os.path.join(working_dir, f\'{dname}_run_metrics.npy\'), sub.to_records(index=False))\n\n```', 'Execution Output': '```\nTraceback (most recent call last):\n  File "C:\\Users\\lukas\\AutoRecLab_Team7\\treesearch\\interpreter.py", line 147, in _run_session\n    exec(compile(code, self.agent_file_name, "exec"), global_scope)\n         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File "runfile.py", line 356\n    ok1 = plot_metric_bars(results_df, metric, f\'{metric.replace(\'@\', \'_at_\')}_by_dataset.png\') if 