s.als import ImplicitMF\nfrom lenskit.algorithms.item_knn import ItemItem\n\nSEEDS = [1, 11, 21, 31, 41]\nKS = [1, 5, 10]\nALGOS = ['ALS', 'ItemKNN', 'Pop']\n\nexperiment_data = {\n    'ml100k': {'metrics': {'train': [], 'val': []}, 'losses': {'train': [], 'val': []}, 'predictions': [], 'ground_truth': []},\n    'amazon_vg': {'metrics': {'train': [], 'val': []}, 'losses': {'train': [], 'val': []}, 'predictions': [], 'ground_truth': []},\n    'lastfm': {'metrics': {'train': [], 'val': []}, 'losses': {'train': [], 'val': []}, 'predictions': [], 'ground_truth': []},\n}\n\n\ndef k_core_filter(df, user_col='user', item_col='item', min_k=5):\n    df = df[[user_col, item_col]].drop_duplicates().copy()\n    changed = True\n    while changed and len(df):\n        before = len(df)\n        uc = df[user_col].value_counts()\n        ic = df[item_col].value_counts()\n        keep_u = uc[uc >= min_k].index\n        keep_i = ic[ic >= min_k].index\n        df = df[df[user_col].isin(keep_u) & df[item_col].isin(keep_i)]\n        changed = len(df) != before\n    df = df.reset_index(drop=True)\n    df['rating'] = 1.0\n    return df[['user', 'item', 'rating']]\n\n\ndef load_ml100k(path='u.data'):\n    df = pd.read_csv(path, sep='\\t', header=None, names=['user', 'item', 'rating', 'timestamp'])\n    df = df[df['rating'] > 3][['user', 'item']]\n    return k_core_filter(df)\n\n\ndef load_amazon(path='VideoGames.csv'):\n    raw = pd.read_csv(path, header=None)\n    if raw.shape[1] >= 4:\n        raw = raw.iloc[:, :4]\n        raw.columns = ['user', 'item', 'rating', 'timestamp']\n    else:\n        raw.columns = ['user', 'item', 'rating']\n    df = raw[raw['rating'] > 3][['user', 'item']]\n    return k_core_filter(df)\n\n\ndef load_lastfm(path='user_taggedartists-timestamps.dat'):\n    df = pd.read_csv(path, sep='\\t')\n    cols = {c.lower(): c for c in df.columns}\n    user_col = cols.get('userid', list(df.columns)[0])\n    item_col = cols.get('artistid', list(df.columns)[1])\n    df = df[[user_col, item_col]].rename(columns={user_col: 'user', item_col: 'item'})\n    return k_core_filter(df)\n\n\ndef user_holdout(df, seed, frac=0.2):\n    rng = np.random.default_rng(seed)\n    tr_parts, te_parts = [], []\n    for _, udf in df.groupby('user', sort=False):\n        udf = udf.reset_index(drop=True)\n        idx = np.arange(len(udf))\n        rng.shuffle(idx)\n        n_te = max(1, int(np.ceil(len(udf) * frac)))\n        te_idx = idx[:n_te]\n        tr_idx = idx[n_te:]\n        if len(tr_idx) == 0:\n            tr_idx = idx[1:]\n            te_idx = idx[:1]\n        tr_parts.append(udf.iloc[tr_idx])\n        te_parts.append(udf.iloc[te_idx])\n    train = pd.concat(tr_parts, ignore_index=True)[['user', 'item', 'rating']]\n    test = pd.concat(te_parts, ignore_index=True)[['user', 'item', 'rating']]\n    return train, test\n\n\ndef precision_at_k(recs, truth, k):\n    topk = recs[:k]\n    return sum(1 for x in topk if x in truth) / k if k > 0 else 0.0\n\n\ndef ndcg_at_k(recs, truth, k):\n    topk = recs[:k]\n    dcg = sum((1.0 / np.log2(i + 2)) for i, x in enumerate(topk) if x in truth)\n    ideal = sum(1.0 / np.log2(i + 2) for i in range(min(len(truth), k)))\n    return dcg / ideal if ideal > 0 else 0.0\n\n\ndef make_algo(name):\n    if name == 'ALS':\n        return ImplicitMF(20, iterations=10, weight=40)\n    if name == 'ItemKNN':\n        return ItemItem(20)\n    return Popular()\n\n\ndef recommend_all(algo, train, users, n=10):\n    fitted = Recommender.adapt(algo)\n    fitted.fit(train[['user', 'item', 'rating']])\n    recs = []\n    for u in users:\n        try:\n            ru = fitted.recommend(u, n)\n            if ru is not None and len(ru):\n                ru = ru.copy()\n                ru['user'] = u\n                if 'score' not in ru.columns:\n                    ru['score'] = np.nan\n                recs.append(ru[['user', 'item', 'score']])\n        except Exception:\n            pass\n    if not recs:\n        return pd.DataFrame(columns=['user', 'item', 'score'])\n    return pd.concat(recs, ignore_index=True)\n\n\ndef evaluate_run(train, test, algo_name):\n    algo = make_algo(algo_name)\n    users = sorted(test['user'].unique())\n    recs = recommend_all(algo, train, users, n=max(KS))\n    truth = test.groupby('user')['item'].apply(set).to_dict()\n    by_user = {u: [] for u in users}\n    if len(recs):\n        for u, udf in recs.groupby('user'):\n            by_user[u] = list(udf.sort_values('score', ascending=False, na_position='last')['item'])\n    rows = []\n    for u in users:\n        gt = truth.get(u, set())\n        pred = by_user.get(u, [])\n        row = {'user': u}\n        for k in KS:\n            row[f'Precision@{k}'] = precision_at_k(pred, gt, k)\n            row[f'nDCG@{k}'] = ndcg_at_k(pred, gt, k)\n        rows.append(row)\n    return pd.DataFrame(rows), recs, truth\n\n\ndatasets = {\n    'ml100k': load_ml100k('u.data'),\n    'amazon_vg': load_amazon('VideoGames.csv'),\n    'lastfm': load_lastfm('user_taggedartists-timestamps.dat'),\n}\n\nall_results = []\nfor dname, df in datasets.items():\n    print(f'Loaded {dname}: {len(df)} interactions, users={df.user.nunique()}, items={df.item.nunique()}')\n    for seed in SEEDS:\n        train, test = user_holdout(df, seed, 0.2)\n        print(f'Epoch {seed}: validation_loss = {0.0:.4f}')\n        for algo in ALGOS:\n            mdf, recs, truth = evaluate_run(train, test, algo)\n            metric_cols = [f'Precision@{k}' for k in KS] + [f'nDCG@{k}' for k in KS]\n            avg = {m: float(mdf[m].mean()) if len(mdf) else 0.0 for m in metric_cols}\n            avg.update({'dataset': dname, 'seed': seed, 'algorithm': algo, 'n_users_eval': int(len(mdf))})\n            all_results.append(avg)\n            experiment_data[dname]['metrics']['val'].append({'epoch': seed, 'seed': seed, 'algorithm': algo, **avg})\n            experiment_data[dname]['losses']['val'].append({'epoch': seed, 'seed': seed, 'algorithm': algo, 'validation_loss': 0.0})\n            experiment_data[dname]['predictions'].append({'seed': seed, 'algorithm': algo, 'data': recs.to_dict('records')})\n            experiment_data[dname]['ground_truth'].append({'seed': seed, 'algorithm': algo, 'data': {str(k): list(v) for k, v in truth.items()}})\n            show = {k: round(v, 4) for k, v in avg.items() if k not in ['dataset', 'algorithm', 'seed', 'n_users_eval']}\n            print(dname, seed, algo, show)\n\nresults_df = pd.DataFrame(all_results)\nresults_df.to_csv(os.path.join(working_dir, 'results_summary.csv'), index=False)\nnp.save(os.path.join(working_dir, 'results_summary.npy'), results_df.to_dict('records'))\n\nsummary = results_df.groupby(['dataset', 'algorithm']).agg(['mean', 'std'])\nprint('\\nAggregate over seeds:')\nprint(summary)\nsummary.to_csv(os.path.join(working_dir, 'aggregate_summary.csv'))\nnp.save(os.path.join(working_dir, 'aggregate_summary.npy'), summary.to_dict())\n\nstats_rows = []\nmetrics = [f'Precision@{k}' for k in KS] + [f'nDCG@{k}' for k in KS]\nfor dname in datasets:\n    sub = results_df[results_df['dataset'] == dname]\n    for metric in metrics:\n        vals = []\n        for algo in ALGOS:\n            arr = sub[sub['algorithm'] == algo].sort_values('seed')[metric].values\n            vals.append(arr)\n        if all(len(v) == len(SEEDS) for v in vals):\n            f_stat, p_val = stats.f_oneway(*vals)\n            stats_rows.append({'dataset': dname, 'metric': metric, 'test': 'anova_across_algorithms', 'stat': float(f_stat), 'p_value': float(p_val)})\n    for i in range(len(ALGOS)):\n        for j in range(i + 1, len(ALGOS)):\n            a, b = ALGOS[i], ALGOS[j]\n            da = sub[sub['algorithm'] == a].sort_values('seed')\n            db = sub[sub['algorithm'] == b].sort_values('seed')\n            for m in metrics:\n                if len(da) == len(db) == len(SEEDS):\n                    t, p = stats.ttest_rel(da[m].values, db[m].values)\n                    diff = da[m].values - db[m].values\n                    stats_rows.append({\n                        'dataset': dname, 'metric': m, 'test': 'paired_ttest', 'algo_a': a, 'algo_b': b,\n                        'stat': float(t), 'p_value': float(p), 'mean_diff': float(np.mean(diff)), 'std_diff': float(np.std(diff, ddof=1)) if len(diff) > 1 else 0.0\n                    })\n    for algo in ALGOS:\n        da = sub[sub['algorithm'] == algo].sort_values('seed')\n        for m in metrics:\n            if len(da) == len(SEEDS):\n                vals = da[m].values\n                stats_rows.append({\n                    'dataset': dname, 'metric': m, 'test': 'seed_variability', 'algorithm': algo,\n                    'stat': float(np.std(vals, ddof=1)), 'p_value': np.nan,\n                    'mean': float(np.mean(vals)), 'min': float(np.min(vals)), 'max': float(np.max(vals)), 'cv': float(np.std(vals, ddof=1) / np.mean(vals)) if np.mean(vals) != 0 else np.nan\n                })\n\nstat_df = pd.DataFrame(stats_rows)\nprint('\\nStatistical analysis:')\nprint(stat_df)\nstat_df.to_csv(os.path.join(working_dir, 'statistical_analysis.csv'), index=False)\nnp.save(os.path.join(working_dir, 'statistical_analysis.npy'), stat_df.to_dict('records'))\n\ntry:\n    import matplotlib.pyplot as plt\n    for dname in datasets:\n        fig, axes = plt.subplots(1, 2, figsize=(10, 4))\n        sub = results_df[results_df['dataset'] == dname]\n        for algo in ALGOS:\n            ss = sub[sub['algorithm'] == algo].sort_values('seed')\n            axes[0].plot(ss['seed'], ss['nDCG@10'], marker='o', label=algo)\n            axes[1].plot(ss['seed'], ss['Precision@10'], marker='o', label=algo)\n        axes[0].set_title(f'{dname} nDCG@10 by seed')\n        axes[1].set_title(f'{dname} Precision@10 by seed')\n        for ax in axes:\n            ax.set_xlabel('seed')\n            ax.grid(True, alpha=0.3)\n            ax.legend()\n        plt.tight_layout()\n        fig.savefig(os.path.join(working_dir, f'{dname}_seed_variability.png'), dpi=150)\n        plt.close(fig)\nexcept ImportError:\n    print('matplotlib not available; skipping plot generation.')\n\nnp.save(os.path.join(working_dir, 'experiment_data.npy'), experiment_data)\nprint(f'\\nSaved outputs to {working_dir}')\n```", 'Execution Output': "```\nLoaded ml100k: 54413 interactions, users=938, items=1008\nEpoch 1: validation_loss = 0.0000\nNumba is using threading layer omp - consider TBB\nfound 1 potential runtime problems - see https://boi.st/lkpy-perf\nml100k 1 ALS {'Precision@1': 0.1642, 'Precision@5': 0.1588, 'Precision@10': 0.1498, 'nDCG@1': 0.1642, 'nDCG@5': 0.1752, 'nDCG@10': 0.1992}\nnormalized ratings are zero, centering is not recommended\nml100k 1 ItemKNN {'Precision@1': 0.0, 'Precision@5': 0.0, 'Precision@10': 0.0, 'nDCG@1': 0.0, 'nDCG@5': 0.0, 'nDCG@10': 0.0}\nml100k 1 Pop {'Precision@1': 0.2036, 'Precision@5': 0.1388, 'Precision@10': 0.1188, 'nDCG@1': 0.2036, 'nDCG@5': 0.1565, 'nDCG@10': 0.1521}\nEpoch 11: validation_loss = 0.0000\nml100k 11 ALS {'Precision@1': 0.1748, 'Precision@5': 0.1665, 'Precision@10': 0.1506, 'nDCG@1': 0.1748, 'nDCG@5': 0.1817, 'nDCG@10': 0.2028}\nnormalized ratings are zero, centering is not recommended\nml100k 11 ItemKNN {'Precision@1': 0.0, 'Precision@5': 0.0, 'Precision@10': 0.0, 'nDCG@1': 0.0, 'nDCG@5': 0.0, 'nDCG@10': 0.0}\nml100k 11 Pop {'Precision@1': 0.2154, 'Precision@5': 0.1467, 'Precision@10': 0.1174, 'nDCG@1': 0.2154, 'nDCG@5': 0.1648, 'nDCG@10': 0.1544}\nEpoch 21: validation_loss = 0.0000\nml100k 21 ALS {'Precision@1': 0.1695, 'Precision@5': 0.1552, 'Precision@10': 0.1466, 'nDCG@1': 0.1695, 'nDCG@5': 0.1688, 'nDCG@10': 0.1916}\nnormalized ratings are zero, centering is not recommended\nml100k 21 ItemKNN {'Precision@1': 0.0, 'Precision@5': 0.0, 'Precision@10': 0.0, 'nDCG@1': 0.0, 'nDCG@5': 0.0, 'nDCG@10': 0.0}\nml100k 21 Pop {'Precision@1': 0.2175, 'Precision@5': 0.1424, 'Precision@10': 0.1235, 'nDCG@1': 0.2175, 'nDCG@5': 0.1631, 'nDCG@10': 0.1609}\nEpoch 31: validation_loss =