ns\\ncandidate_paths = [\\n    \'u.data\',\\n    \'ml-100k/u.data\',\\n    \'./ml-100k/u.data\',\\n    \'./data/u.data\',\\n    \'./datasets/ml-100k/u.data\',\\n    \'../ml-100k/u.data\',\\n]\\ndata_path = None\\nfor p in candidate_paths:\\n    if os.path.exists(p):\\n        data_path = p\\n        break\\nif data_path is None:\\n    raise FileNotFoundError(\'Could not locate u.data. Please place the MovieLens-100k u.data in one of the expected paths.\')\\n\\nprint(f\'Loading data from: {data_path}\')\\n\\n# Load data (u.data format: user_id\\\\titem_id\\\\trating\\\\ttimestamp)\\ndf = pd.read_csv(data_path, sep=\'\\\\t\', header=None, names=[\'user\',\'item\',\'rating\',\'timestamp\'], engine=\'python\')\\n\\n# Basic statistics\\nn_users = df[\'user\'].nunique()\\nn_items = df[\'item\'].nunique()\\nprint(f\'Total unique users: {n_users}\')\\nprint(f\'Total unique items: {n_items}\')\\n\\n# Top 3 most active users by number of ratings\\nuser_counts = df[\'user\'].value_counts()\\ntop3 = user_counts.head(3)\\nprint(\'Top 3 most active users (user_id -> rating_count):\')\\nfor uid, cnt in top3.items():\\n    print(f\'  User {uid}: {cnt} ratings\')\\n\\n# For the #1 most active user, mean rating\\nif not top3.empty:\\n    top1_user = int(top3.index[0])\\n    top1_mean = df.loc[df[\'user\'] == top1_user, \'rating\'].mean()\\n    print(f\'Mean rating for top active user {top1_user}: {top1_mean:.4f}\')\\nelse:\\n    top1_user = None\\n    top1_mean = None\\n\\n# Identify Item 50 and Item 181, compute co-occurrence\\nusers_w_50 = set(df.loc[df[\'item\'] == 50, \'user].tolist()) if False else set()\\n# The above line has a placeholder fix; implement cleanly:\\nusers_50 = set(df.loc[df[\'item\'] == 50, \'user\'].astype(int).tolist())\\nusers_181 = set(df.loc[df[\'item\'] == 181, \'user\'].astype(int).tolist())\\ncooccurrence = len(users_50.intersection(users_181))\\nprint(f\'Co-occurrence (users who rated both item 50 and 181): {cooccurrence}\')\\n\\n# Timestamp range check: convert epoch seconds to year and detect out-of-range years beyond 1997-1998\\nyears = pd.to_datetime(df[\'timestamp\'], unit=\'s\').dt.year\\nout_of_range_years = years[(years < 1997) | (years > 1998)]\\nprint(f\'Number of ratings with timestamp outside 1997-1998: {int(out_of_range_years.count())}\')\\n\\n# Prepare a simple SGD-based matrix factorization baseline with biases\\n# Map user/item IDs to 0-based indices\\nunique_users = df[\'user\'].unique()\\nunique_items = df[\'item\'].unique()\\nuser_to_idx = {u: i for i, u in enumerate(unique_users)}\\nitem_to_idx = {i: j for j, i in enumerate(unique_items)}\\nnU = len(unique_users)\\nnI = len(unique_items)\\n\\n# Train-test split (80/20)\\nseed = 42\\ndf = df.sample(frac=1, random_state=seed).reset_index(drop=True)\\nsplit = int(0.8 * len(df))\\ndf_train = df.iloc[:split].copy()\\ndf_val = df.iloc[split:].copy()\\n\\n# Prepare training data arrays\\nu_train = df_train[\'user\'].map(user_to_idx).values\\ni_train = df_train[\'item\'].map(item_to_idx).values\\nr_train = df_train[\'rating\'].astype(float).values\\n\\nu_val = df_val[\'user\'].map(user_to_idx).values\\ni_val = df_val[\'item\'].map(item_to_idx).values\\nr_val = df_val[\'rating\'].astype(float).values\\n\\n# Initialize model parameters\\nK = 8  # latent factors\\nnp.random.seed(0)\\nU = np.random.normal(scale=0.1, size=(nU, K))\\nV = np.random.normal(scale=0.1, size=(nI, K))\\nbu = np.zeros(nU)\\n<|vq_8368|># global mean computed on training data\\nmu = r_train.mean()\\nbi = np.zeros(nI)\\n\\n# SGD hyperparameters\\nlr = 0.005\\nreg = 0.02\\nreg_bias = 0.02\\nn_epochs = 20\\n\\ntrain_rmse_history = []\\nval_rmse_history = []\\n\\n# Helper to compute RMSE on a dataset\\nfrom math import sqrt\\n\\ndef rmse_of(u_arr, i_arr, r_arr):\\n    pred = mu + bu[u_arr] + bi[i_arr] + np.sum(U[u_arr] * V[i_arr], axis=1)\\n    return sqrt(np.mean((r_arr - pred) ** 2))\\n\\nfor epoch in range(1, n_epochs + 1):\\n    idxs = np.arange(len(r_train))\\n    np.random.shuffle(