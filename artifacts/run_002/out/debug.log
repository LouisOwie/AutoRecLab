\ntry:\n    df = pd.read_csv(data_path, sep='\\t', header=None, names=['user_id', 'item_id', 'rating', 'timestamp'])\nexcept Exception as e:\n    print('Error loading data:', e)\n    raise\n\n# Basic counts\nn_users = df['user_id'].nunique()\nn_items = df['item_id'].nunique()\nprint(f'Unique users: {n_users}, Unique items: {n_items}')\n\n# Top-3 active users by rating count\nuser_counts = df['user_id'].value_counts()\ntop3 = user_counts.head(3)\ntop3_users = top3.index.tolist()\ntop3_counts = top3.values\nprint('Top 3 active users (user_id: count):', [(uid, int(cnt)) for uid, cnt in zip(top3_users, top3_counts)])\n# Mean rating for the #1 user\ntop1 = top3_users[0]\nmean_top1 = df.loc[df['user_id'] == top1, 'rating'].mean()\nprint(f'Top1 user {top1} mean rating: {mean_top1:.4f}')\n\n# Co-occurrence for items 50 and 181\nusers_item_50 = set(df.loc[df['item_id'] == 50, 'user_id'])\nusers_item_181 = set(df.loc[df['item_id'] == 181, 'user_id'])\nco_occurrence = len(users_item_50.intersection(users_item_181))\nprint(f'Co-occurrence (users who rated both item 50 and 181): {co_occurrence}')\n\n# Timestamp range check (1997-1998)\ndt = pd.to_datetime(df['timestamp'], unit='s', utc=False)\nyears = dt.dt.year\nmin_year = years.min()\nmax_year = years.max()\nout_of_range_mask = (years < 1997) | (years > 1998)\nn_out = int(out_of_range_mask.sum())\nprint(f'Timestamp range: min_year={min_year}, max_year={max_year}')\nif n_out > 0:\n    sample = df.loc[out_of_range_mask, ['user_id', 'item_id', 'rating', 'timestamp']].head()\n    print(f'Found {n_out} out-of-range timestamps. Sample rows:\\n{sample}')\nelse:\n    print('All timestamps fall within 1997-1998 range.')\n\n# Prepare data for a simple baseline (global mean + user/item bias)\nratings = df[['user_id', 'item_id', 'rating']].copy()\nunique_users = ratings['user_id'].unique()\nunique_items = ratings['item_id'].unique()\nuser_to_idx = {uid: idx for idx, uid in enumerate(unique_users)}\nitem_to_idx = {iid: idx for idx, iid in enumerate(unique_items)}\nratings['u_idx'] = ratings['user_id'].map(user_to_idx)\nratings['i_idx'] = ratings['item_id'].map(item_to_idx)\n\nN = len(ratings)\nperm = np.random.permutation(N)\ntrain_size = int(0.8 * N)\ntrain_idx = perm[:train_size]\nval_idx = perm[train_size:]\n\ntrain = ratings.iloc[train_idx].reset_index(drop=True)\nval = ratings.iloc[val_idx].reset_index(drop=True)\n\nn_users_tot = len(unique_users)\nn_items_tot = len(unique_items)\n\nglobal_mean = train['rating'].mean() if train.shape[0] > 0 else 0.0\nu_bias = np.zeros(n_users_tot, dtype=np.float32)\ni_bias = np.zeros(n_items_tot, dtype=np.float32)\n\nlr = 0.01\nn_epochs = 8\n\ntrain_rmse_history = []\nval_rmse_history = []\n\nfor ep in range(n_epochs):\n    # SGD over training data\n    for r in train.itertuples(index=False):\n        u = int(r.u_idx)\n        i = int(r.i_idx)\n        pred = global_mean + u_bias[u] + i_bias[i]\n        resid = r.rating - pred\n        u_bias[u] += lr * resid\n        i_bias[i] += lr * resid\n    # Evaluate on training set\n    train_pred = global_mean + u_bias[train['u_idx'].values] + i_bias[train['i_idx'].values]\n    train_pred = np.clip(train_pred, 1.0, 5.0)\n    train_rmse = float(np.sqrt(np.mean((train['rating'].values - train_pred) ** 2))) if train.shape[0] > 0 else 0.0\n    # Evaluate on validation set\n    val_pred = global_mean + u_bias[val['u_idx'].values] + i_bias[val['i_idx'].values]\n    val_pred = np.clip(val_pred, 1.0, 5.0)\n    val_rmse = float(np.sqrt(np.mean((val['rating'].values - val_pred) ** 2))) if val.shape[0] > 0 else 0.0\n    train_rmse_history.append(train_rmse)\n    val_rmse_history.append(val_rmse)\n    print(f'Epoch {ep+1}: validation_loss = {val_rmse:.4f}')\n\n# Final predictions and ground truth for the validation set\nval_final_pred = global_mean + u_bias[val['u_idx'].values] + i_bias[val['i_idx'].values]\nval_final_pred = np.clip(val_final_pred, 1.0, 5.0)\npred_list = val_final_pred.tolist()\nground_truth = val['rating'].values.